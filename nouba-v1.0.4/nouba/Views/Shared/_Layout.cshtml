<!DOCTYPE html>
<html lang="@(Context.Request.Cookies["nouba_lang"] ?? "fr")" dir="@(Context.Request.Cookies["nouba_lang"] == "ar" ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Nouba</title>
    <link rel="icon" type="image/png" href="~/images/favicon.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nouba-premium.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" />
<style>
/* ── Premium global overrides (typographie 100% offline) ──────────────
   Aucune police distante : pile système native, rendu identique sans Internet,
   et prise en charge de l'arabe (Segoe UI / Tahoma sous Windows). */
body, .nouba-premium-layout { font-family: "Segoe UI", system-ui, -apple-system, Roboto, "Helvetica Neue", Arial, "Noto Sans Arabic", Tahoma, sans-serif !important; }
.nouba-premium-layout input,
.nouba-premium-layout select,
.nouba-premium-layout textarea { font-family: "Segoe UI", system-ui, -apple-system, Roboto, "Helvetica Neue", Arial, "Noto Sans Arabic", Tahoma, sans-serif !important; }
/* Scrollbar premium */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: rgba(255,255,255,.03); }
::-webkit-scrollbar-thumb { background: rgba(255,255,255,.12); border-radius: 999px; }
::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,.22); }
/* Smooth transitions globales */
*, *::before, *::after { transition-property: color, background-color, border-color, box-shadow, opacity, transform; transition-duration: 120ms; transition-timing-function: ease; }
a, button { transition-duration: 150ms; }
</style>
<style>
:root{--nouba-bg:#070b16;--nouba-panel:rgba(15,23,42,.82);--nouba-border:rgba(255,255,255,.12);--nouba-gold:#f3c969;--nouba-text:#f8fafc;}
.nouba-premium-layout{min-height:100vh;background:radial-gradient(circle at 15% 0%,rgba(243,201,105,.20),transparent 30%),radial-gradient(circle at 90% 15%,rgba(59,130,246,.18),transparent 35%),linear-gradient(135deg,#020617,#0f172a 55%,#111827);color:var(--nouba-text);}
.nouba-premium-layout .container-fluid{min-height:100vh;}
.nouba-premium-layout .card,.nouba-premium-layout .panel,.nouba-premium-layout .ticket-card{background:var(--nouba-panel)!important;border:1px solid var(--nouba-border)!important;box-shadow:0 24px 70px rgba(0,0,0,.35)!important;backdrop-filter:blur(16px);}
.nouba-premium-layout input,.nouba-premium-layout select,.nouba-premium-layout textarea{border-radius:14px!important;}
</style>
</head>
<body class="nouba-premium-layout">
    <div class="container-fluid px-3 py-3">
        @RenderBody()
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
