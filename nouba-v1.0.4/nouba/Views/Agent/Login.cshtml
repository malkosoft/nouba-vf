@{
    ViewData["Title"] = "Connexion Agent";
    Layout = null;
    var settings = ViewBag.Settings as Nouba.Models.UiSettings ?? new Nouba.Models.UiSettings();
}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>@settings.SiteName — Espace Agent</title>
<link rel="icon" type="image/png" href="~/images/favicon.png"/>
<link rel="stylesheet" href="~/css/nouba-premium.css"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;font-family:var(--np-font-body);background:var(--np-bg-0);color:var(--np-ink)}
body{
  display:flex;align-items:center;justify-content:center;min-height:100vh;
  background:
    radial-gradient(ellipse 80% 60% at 0% 0%,   rgba(232,184,75,.16), transparent),
    radial-gradient(ellipse 60% 50% at 100% 100%,rgba(96,165,250,.10),  transparent),
    var(--np-bg-0);
}
body::before{
  content:'';position:fixed;inset:0;
  background-image:
    linear-gradient(rgba(232,184,75,.04) 1px, transparent 1px),
    linear-gradient(90deg,rgba(232,184,75,.04) 1px, transparent 1px);
  background-size:42px 42px;pointer-events:none;
}
.wrap{
  position:relative;z-index:1;
  display:grid;grid-template-columns:1fr 1fr;
  width:min(820px,95vw);border-radius:var(--np-r-xl);overflow:hidden;
  border:1px solid var(--np-line);
  box-shadow:var(--np-shadow-lg);
  animation:npFadeUp .6s cubic-bezier(.25,1,.4,1) both;
}
/* LEFT SIDE */
.left{
  background:linear-gradient(150deg,#0c1426 0%,#13203c 55%,#1a2238 100%);
  padding:52px 40px;display:flex;flex-direction:column;
  justify-content:space-between;position:relative;overflow:hidden;
}
.left::after{
  content:'';position:absolute;bottom:-80px;right:-80px;
  width:280px;height:280px;border-radius:50%;
  background:radial-gradient(circle,rgba(232,184,75,.22),transparent 70%);
}
.brand{display:flex;align-items:center;gap:14px}
.brand-mark{
  width:54px;height:54px;border-radius:14px;
  background:#fff;
  display:flex;align-items:center;justify-content:center;
  padding:5px;
  box-shadow:0 6px 24px rgba(232,184,75,.35), 0 0 0 1px rgba(255,255,255,.1) inset;
}
.brand-mark img{width:100%;height:100%;object-fit:contain;display:block}
.brand-name{font-family:var(--np-font-display);font-size:1.5rem;font-weight:800;letter-spacing:-.02em}
.brand-tag{font-size:.68rem;text-transform:uppercase;letter-spacing:.14em;color:var(--np-gold);font-weight:700;margin-top:2px}
.left-mid{position:relative;z-index:1;margin-top:48px}
.left-mid h2{font-family:var(--np-font-display);font-size:1.9rem;font-weight:800;line-height:1.2;margin-bottom:12px;letter-spacing:-.03em}
.left-mid h2 em{font-style:normal;color:var(--np-gold)}
.left-mid p{font-size:.88rem;color:var(--np-ink-soft);line-height:1.7}
.pills{display:flex;flex-wrap:wrap;gap:8px;margin-top:28px}
.pill{
  display:inline-flex;align-items:center;gap:6px;
  padding:6px 12px;border-radius:999px;font-size:.75rem;font-weight:700;
  background:rgba(232,184,75,.12);border:1px solid rgba(232,184,75,.28);color:var(--np-gold-soft);
}
.left-foot{position:relative;z-index:1;font-size:.72rem;color:var(--np-ink-faint)}
/* RIGHT SIDE */
.right{
  background:rgba(10,16,30,.97);backdrop-filter:blur(20px);
  padding:52px 44px;display:flex;flex-direction:column;justify-content:center;
}
.right h3{font-family:var(--np-font-display);font-size:1.4rem;font-weight:800;margin-bottom:4px;letter-spacing:-.02em}
.right .sub{font-size:.85rem;color:var(--np-ink-faint);margin-bottom:32px}
.field{margin-bottom:18px}
.field label{display:block;font-size:.72rem;font-weight:700;text-transform:uppercase;
  letter-spacing:.08em;color:var(--np-ink-soft);margin-bottom:8px}
.inp-wrap{position:relative}
.inp-icon{
  position:absolute;left:14px;top:50%;transform:translateY(-50%);
  color:var(--np-ink-faint);pointer-events:none;
}
input{
  width:100%;padding:13px 14px 13px 44px;border-radius:12px;
  background:rgba(2,6,18,.55);border:1.5px solid var(--np-line-strong);
  color:var(--np-ink);font-size:.95rem;font-family:var(--np-font-body);font-weight:600;
  outline:none;transition:border-color .2s,box-shadow .2s;
}
input:focus{border-color:var(--np-gold);box-shadow:0 0 0 4px var(--np-gold-glow)}
input::placeholder{color:var(--np-ink-faint)}
.err{
  background:rgba(248,113,113,.1);border:1px solid rgba(248,113,113,.25);
  border-radius:10px;padding:10px 14px;font-size:.82rem;color:#fca5a5;
  margin-bottom:18px;
}
.btn{
  width:100%;margin-top:8px;padding:15px;border-radius:12px;border:1px solid rgba(255,255,255,.22);
  background:linear-gradient(135deg,var(--np-gold-soft),var(--np-gold) 45%,var(--np-gold-deep));color:#1a1206;
  font-family:var(--np-font-display);font-size:.98rem;font-weight:800;cursor:pointer;letter-spacing:.02em;
  box-shadow:var(--np-shadow-gold);transition:transform .15s,box-shadow .15s,filter .15s;
}
.btn:hover{transform:translateY(-2px);filter:brightness(1.06);box-shadow:0 12px 40px rgba(232,184,75,.42)}
.back{display:block;text-align:center;margin-top:20px;font-size:.8rem;
  color:var(--np-ink-faint);text-decoration:none;transition:color .15s}
.back:hover{color:var(--np-gold)}
@@media(max-width:600px){.wrap{grid-template-columns:1fr}.left{padding:36px 28px}.right{padding:36px 28px}}
</style>
</head>
<body>
<div class="wrap">
  <div class="left">
    <div class="brand">
      <div class="brand-mark"><img src="~/images/nouba-icon.png" alt="Nouba"/></div>
      <div>
        <div class="brand-name">@settings.SiteName</div>
        <div class="brand-tag">Nouba Pro · Queue System</div>
      </div>
    </div>
    <div class="left-mid">
      <h2>Espace <em>Agent</em><br/>de guichet</h2>
      <p>Connectez-vous pour gérer votre file d'attente en temps réel.</p>
      <div class="pills">
        <span class="pill">⚡ Temps réel</span>
        <span class="pill">🎫 Tickets prioritaires</span>
        <span class="pill">↗ Transfert</span>
        <span class="pill">📊 Stats live</span>
      </div>
    </div>
    <div class="left-foot">© 2026 Nouba Software</div>
  </div>
  <div class="right">
    <h3>Connexion agent</h3>
    <p class="sub">Entrez vos identifiants pour accéder à votre poste</p>
    @if (TempData["Error"] != null) {
      <div class="err">⚠️ @TempData["Error"]</div>
    }
    <form asp-action="Login" method="post">
      @Html.AntiForgeryToken()
      <div class="field">
        <label>Identifiant</label>
        <div class="inp-wrap">
          <svg class="inp-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <input name="login" type="text" placeholder="Votre identifiant" required autocomplete="username"/>
        </div>
      </div>
      <div class="field">
        <label>Mot de passe</label>
        <div class="inp-wrap">
          <svg class="inp-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <input name="password" type="password" placeholder="••••••••" required autocomplete="current-password"/>
        </div>
      </div>
      <button type="submit" class="btn">Se connecter →</button>
    </form>
    <a href="@Url.Action("Index","Borne")" class="back">← Retour à la borne kiosque</a>
  </div>
</div>
</body>
</html>
