<script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
<script>
// ── Animation blink du voyant en alerte ──
var __style = document.createElement('style');
__style.textContent = '@@keyframes nouba-blink{0%,100%{opacity:1}50%{opacity:.3}} .blink{animation:nouba-blink 1s ease-in-out infinite}';
document.head.appendChild(__style);
// ── Clock ──
function tick(){
    var d=new Date();
    document.getElementById('clock').textContent=
        d.toLocaleDateString('fr-FR',{weekday:'short',day:'2-digit',month:'short'})+' '+
        d.toLocaleTimeString('fr-FR');
}
tick(); setInterval(tick,1000);

// ── Tab switching ──
var tabTitles={
    dashboard:'Tableau de bord',services:'Services',counters:'Guichets',
    agents:'Agents',display:'Écran d\'affichage',borne:'Borne kiosque',
    printer:'Imprimante',texts:'Textes & Langues',diagnostic:'Diagnostic',system:'Système'
};
function switchTab(id){
    document.querySelectorAll('.tab-pane').forEach(p=>p.classList.remove('active'));
    document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
    var pane=document.getElementById('tab-'+id);
    if(pane) pane.classList.add('active');
    document.querySelectorAll('.nav-item').forEach(n=>{
        if(n.getAttribute('onclick')==="switchTab('"+id+"')") n.classList.add('active');
    });
    document.getElementById('pageTitle').textContent=tabTitles[id]||id;
    history.replaceState(null,'','?tab='+id);
}

// ════════════════════════════════════════════════════════════════
// ══   IMPRIMANTE : sélecteur de connexion + détection           ══
// ════════════════════════════════════════════════════════════════
function updateConnUi(){
    var sel = document.querySelector('input[name="printerConnection"]:checked');
    if(!sel) return;
    var v = sel.value;
    document.querySelectorAll('[data-conn-fields]').forEach(function(el){
        el.style.display = el.getAttribute('data-conn-fields') === v ? 'block' : 'none';
    });
    // Mettre en surbrillance la carte sélectionnée
    document.querySelectorAll('[data-conn-card]').forEach(function(card){
        var match = card.getAttribute('data-conn-card') === v;
        card.style.borderColor = match ? '#f3d486' : 'var(--border)';
        card.style.background  = match ? 'rgba(232,184,75,.12)' : 'var(--surface2)';
    });
}
async function detectPrinters(){
    var sel = document.getElementById('printerNameSelect');
    var comSel = document.getElementById('printerComPortSelect');
    var comInp = document.getElementById('printerComPortInput');
    if(sel) sel.innerHTML = '<option>Détection en cours…</option>';
    try{
        var r = await fetch('/Printer/List');
        var j = await r.json();
        // Imprimantes Windows installées
        if(sel){
            sel.innerHTML = '';
            if(!j.printers || j.printers.length === 0){
                var o = document.createElement('option');
                o.value=''; o.textContent='Aucune imprimante détectée — installez-en une dans Windows.';
                sel.appendChild(o);
            } else {
                var blank = document.createElement('option'); blank.value=''; blank.textContent='— Sélectionnez —'; sel.appendChild(blank);
                j.printers.forEach(function(p){ var o=document.createElement('option'); o.value=p; o.textContent=p; sel.appendChild(o); });
            }
        }
        // Ports COM
        if(comSel && j.comPorts && j.comPorts.length){
            comSel.innerHTML = '';
            j.comPorts.forEach(function(p){ var o=document.createElement('option'); o.value=p; o.textContent=p; comSel.appendChild(o); });
            comSel.style.display='block'; comInp.style.display='none';
        }
    }catch(e){
        if(sel) sel.innerHTML = '<option value="">Erreur : ' + e.message + '</option>';
    }
}


function setMiniCard(container, title, ok, text){
    var color = ok ? '#22c55e' : '#f59e0b';
    return '<div class="mini-status-card" style="border-color:'+color+'55"><strong>'+title+'</strong><span style="color:'+color+'">'+text+'</span></div>';
}
function refreshTtsStatus(){
    fetch('/Tts/Status', {cache:'no-store'}).then(r=>r.json()).then(d=>{
        var pill=document.getElementById('ttsAdminPill');
        if(pill){ pill.textContent = d.available ? 'Voix locale activée' : 'Voix du navigateur utilisée'; pill.style.color = d.available ? '#86efac' : '#fbbf24'; }
        var box=document.getElementById('ttsStatusCards');
        if(box){
            box.innerHTML = setMiniCard(box,'Français', d.fr && d.fr.ready, d.fr && d.fr.ready ? 'Voix locale prête' : 'Voix navigateur')
                        + setMiniCard(box,'English', d.en && d.en.ready, d.en && d.en.ready ? 'Voix locale prête' : 'Voix navigateur')
                        + setMiniCard(box,'العربية', d.ar && d.ar.ready, (d.ar && d.ar.ready ? ('Voix locale prête' + (d.ar.female ? ' + féminine disponible' : '')) : 'Voix navigateur'));
        }
    }).catch(()=>{});
}
