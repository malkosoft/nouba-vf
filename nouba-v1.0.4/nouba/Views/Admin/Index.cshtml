    var card = input.closest('[data-voice-gender-card]');
    if(card){
        card.addEventListener('click', function(){
            if(input.disabled){
                setVoiceGenderStatus('Cette voix n est pas disponible avec Piper.', false);
                return;
            }
            if(!input.checked){
                input.checked = true;
                input.dispatchEvent(new Event('change', { bubbles: true }));
            }
        }, true);
    }
});

