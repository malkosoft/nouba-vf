@model List<Nouba.Models.ServiceType>
@using System.Linq
@{
    ViewData["Title"] = "Administration — Nouba Pro";
    Layout = null;
    var counters  = ViewBag.Counters  as List<Nouba.Models.Counter>  ?? new();
    var agents    = ViewBag.Agents    as List<Nouba.Models.Agent>    ?? new();
    var settings  = ViewBag.Settings  as Nouba.Models.UiSettings     ?? new();
    var recentCalls = ViewBag.RecentCalls as List<Nouba.Models.CallHistory> ?? new();
    var agentStats = ViewBag.AgentStats as List<Nouba.Models.AgentDashboardStat> ?? new List<Nouba.Models.AgentDashboardStat>();

    int waitingNow   = (int)(ViewBag.WaitingNow  ?? 0);
    int calledNow    = (int)(ViewBag.CalledNow   ?? 0);
    int servedToday  = (int)(ViewBag.ServedToday ?? 0);
    int absentToday  = (int)(ViewBag.AbsentToday ?? 0);
    int totalToday   = (int)(ViewBag.TotalToday  ?? 0);
    double avgWait   = (double)(ViewBag.AvgWaitMinutes ?? 0.0);
    string adminName = ViewBag.AdminName ?? "Admin";
    bool isProvider = (bool)(ViewBag.IsProvider ?? false);
    var adminAccounts = ViewBag.AdminAccounts as List<Nouba.Models.AdminUser> ?? new List<Nouba.Models.AdminUser>();

    var tab = (Context.Request.Query["tab"].FirstOrDefault() ?? "dashboard");
    // Sécurité : un client ne peut pas ouvrir un onglet technique via l'URL.
    if (!isProvider && (tab == "printer" || tab == "diagnostic")) { tab = "dashboard"; }

    bool sysHasAlert    = (bool)(ViewBag.SystemHasAlert ?? false);
    bool sysDiskWarn    = (bool)(ViewBag.SystemDiskWarn ?? false);
    bool sysDbOk        = (bool)(ViewBag.SystemDbOk ?? true);
    long sysDiskFreeMb  = (long)(ViewBag.SystemDiskFreeMb ?? 0L);
    long sysDiskTotalMb = (long)(ViewBag.SystemDiskTotalMb ?? 0L);
    string tunnelStatusTop = ViewBag.TunnelStatus as string ?? "initializing";
    string? tunnelUrlTop   = ViewBag.TunnelUrl as string;
}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>@ViewData["Title"]</title>
<link rel="icon" type="image/png" href="~/images/favicon.png"/>
<link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true"/>
<style>
:root{
  --sidebar-w:260px;
  /* Identité unifiée OR / BLEU NUIT (alignée sur nouba-premium.css).
     L'accent passe du violet à l'or : tous les boutons, badges et états
     actifs de l'Admin basculent automatiquement, sans toucher au HTML. */
  --accent:#e8b84b;--accent2:#f3d486;--accent-dark:#b8862b;
  --bg:#070d1c;--surface:#0b1426;--surface2:#111d36;--surface3:#18274a;
  --border:rgba(255,255,255,0.09);
  --text:#f6f8fc;--muted:#aab6ce;--success:#34d399;--warn:#fbbf24;--danger:#f87171;
  --font-display:"Segoe UI Semibold","Segoe UI",system-ui,-apple-system,Roboto,"Noto Sans Arabic",Tahoma,sans-serif;
  --font-body:"Segoe UI",system-ui,-apple-system,Roboto,"Helvetica Neue",Arial,"Noto Sans Arabic",Tahoma,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0;}
html,body{height:100%;font-family:var(--font-body);background:var(--bg);color:var(--text);}
a{text-decoration:none;color:inherit;}

/* Fallback CSS local : aucune dépendance Internet requise */
.vstack{display:flex;flex-direction:column;}
.gap-1{gap:.25rem}.gap-2{gap:.5rem}.gap-3{gap:1rem}.gap-4{gap:1.5rem}
.d-flex{display:flex}.align-items-center{align-items:center}.justify-content-between{justify-content:space-between}
.me-1{margin-right:.25rem}.me-2{margin-right:.5rem}.ms-auto{margin-left:auto}.mt-2{margin-top:.5rem}.mb-0{margin-bottom:0}

/* ── Sidebar ── */
.sidebar{
  position:fixed;top:0;left:0;width:var(--sidebar-w);height:100vh;
  background:var(--surface);border-right:1px solid var(--border);
  display:flex;flex-direction:column;z-index:100;overflow-y:auto;
}
.sidebar-brand{
  padding:24px 20px 16px;display:flex;align-items:center;gap:12px;
  border-bottom:1px solid var(--border);
}
.brand-icon{
  width:44px;height:44px;border-radius:11px;
  background:#fff;
  display:flex;align-items:center;justify-content:center;
  padding:4px;flex-shrink:0;
  box-shadow:0 4px 14px rgba(232,184,75,.18), 0 0 0 1px rgba(255,255,255,.08) inset;
}
.brand-icon img{width:100%;height:100%;object-fit:contain;display:block;}
.brand-text .name{font-weight:800;font-size:1.05rem;color:#fff;}
.brand-text .version{font-size:.7rem;color:var(--muted);letter-spacing:.5px;text-transform:uppercase;}

.nav-section{padding:16px 12px 6px;}
.nav-section-label{font-size:.65rem;text-transform:uppercase;letter-spacing:1.2px;color:var(--muted);padding:0 8px;margin-bottom:4px;}
.nav-item{
  display:flex;align-items:center;gap:10px;padding:10px 12px;
  border-radius:10px;cursor:pointer;transition:background .15s;
  font-size:.88rem;font-weight:500;color:var(--muted);border:none;background:none;width:100%;text-align:left;
}
.nav-item:hover{background:rgba(255,255,255,.05);color:var(--text);}
.nav-item.active{background:rgba(232,184,75,.16);color:var(--accent2);}
.nav-item.active .nav-icon{color:var(--accent);}
.nav-icon{width:20px;text-align:center;font-size:1rem;}
.nav-badge{margin-left:auto;background:var(--accent);color:#1a1206;font-size:.65rem;padding:2px 7px;border-radius:20px;font-weight:800;}

.sidebar-footer{
  margin-top:auto;padding:16px 12px;border-top:1px solid var(--border);
}
.admin-profile{
  display:flex;align-items:center;gap:10px;padding:10px 12px;
  border-radius:10px;cursor:pointer;transition:background .15s;
}
.admin-profile:hover{background:rgba(255,255,255,.05);}
.admin-avatar{
  width:34px;height:34px;border-radius:8px;
  background:linear-gradient(135deg,#b8862b,#4f46e5);
  display:flex;align-items:center;justify-content:center;
  font-weight:700;font-size:.9rem;color:#fff;flex-shrink:0;
}
.admin-name{font-size:.85rem;font-weight:600;color:var(--text);}
.admin-role{font-size:.72rem;color:var(--muted);}

/* ── Main layout ── */
.main{margin-left:var(--sidebar-w);display:flex;flex-direction:column;min-height:100vh;}
.topbar{
  position:sticky;top:0;z-index:50;
  background:rgba(15,17,23,.9);backdrop-filter:blur(12px);
  border-bottom:1px solid var(--border);
  padding:0 28px;height:60px;display:flex;align-items:center;justify-content:space-between;
}
.topbar-title{font-size:1.05rem;font-weight:700;color:#fff;}
.topbar-actions{display:flex;align-items:center;gap:10px;}
.topbar-btn{
  display:flex;align-items:center;gap:6px;padding:7px 14px;
  border-radius:8px;font-size:.82rem;font-weight:600;cursor:pointer;
  border:1px solid var(--border);background:var(--surface2);color:var(--text);transition:all .15s;
}
.topbar-btn:hover{background:var(--surface3);}
.topbar-btn.primary{background:var(--accent);border-color:var(--accent);color:#1a1206;font-weight:800;}
.topbar-btn.primary:hover{background:var(--accent2);}
.topbar-btn.danger{background:rgba(239,68,68,.15);border-color:rgba(239,68,68,.3);color:#fca5a5;}
.topbar-btn.danger:hover{background:rgba(239,68,68,.25);}

/* ── Content ── */
.content{padding:28px;flex:1;}

/* ── KPI Cards ── */
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;margin-bottom:28px;}
.kpi-card{
  background:var(--surface);border:1px solid var(--border);border-radius:16px;
  padding:20px;display:flex;flex-direction:column;gap:6px;
  transition:transform .2s, box-shadow .2s;position:relative;overflow:hidden;
}
.kpi-card::before{
  content:'';position:absolute;top:0;left:0;right:0;height:3px;
  background:var(--kpi-color,var(--accent));
}
.kpi-card:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.3);}
.kpi-icon{font-size:1.4rem;margin-bottom:4px;}
.kpi-value{font-size:2rem;font-weight:800;color:#fff;line-height:1;}
.kpi-label{font-size:.75rem;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;}
.kpi-trend{font-size:.75rem;color:var(--success);display:flex;align-items:center;gap:4px;}

/* ── Panels ── */
.panel{background:var(--surface);border:1px solid var(--border);border-radius:16px;overflow:hidden;}
.panel-header{
  padding:18px 20px;border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
}
.panel-header h2{font-size:.95rem;font-weight:700;color:#fff;margin:0;}
.panel-header p{font-size:.78rem;color:var(--muted);margin:0;}
.panel-body{padding:20px;}

/* ── Grid layouts ── */
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
.grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;}
.grid-auto{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;}
@@media(max-width:900px){.grid-2,.grid-3{grid-template-columns:1fr;}.sidebar{transform:translateX(-100%);}}

/* ── Form controls ── */
label{color:var(--muted);font-size:.8rem;font-weight:600;display:block;margin-bottom:5px;text-transform:uppercase;letter-spacing:.3px;}
.form-control,.form-select{
  background:var(--surface2);border:1px solid var(--border);
  color:var(--text);border-radius:10px;padding:9px 12px;font-size:.87rem;width:100%;
}
.form-control:focus,.form-select:focus{
  border-color:var(--accent);outline:none;box-shadow:0 0 0 3px rgba(232,184,75,.2);
  background:var(--surface3);
}
.form-control::placeholder{color:rgba(255,255,255,.25);}
.form-select option{background:var(--surface2);}
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:6px;
  padding:9px 16px;border-radius:10px;font-size:.85rem;font-weight:600;cursor:pointer;
  border:none;transition:all .15s;
}
.btn-primary{background:var(--accent);color:#1a1206;font-weight:800;}
.btn-primary:hover{background:var(--accent-dark);}
.btn-success{background:rgba(34,197,94,.15);color:#86efac;border:1px solid rgba(34,197,94,.3);}
.btn-success:hover{background:rgba(34,197,94,.25);}
.btn-danger{background:rgba(239,68,68,.12);color:#fca5a5;border:1px solid rgba(239,68,68,.25);}
.btn-danger:hover{background:rgba(239,68,68,.22);}
.btn-ghost{background:transparent;color:var(--muted);border:1px solid var(--border);}
.btn-ghost:hover{background:var(--surface2);color:var(--text);}
.btn-sm{padding:6px 12px;font-size:.78rem;}
.btn-w{width:100%;}

/* ── Tabs ── */
.tab-pane{display:none;animation:fadeIn .2s ease;}
.tab-pane.active{display:block;}
@@keyframes fadeIn{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:none;}}

/* ── Settings UX refresh ── */
.settings-savebar{
  position:sticky;top:60px;z-index:45;
  margin:-8px 0 20px;padding:14px 16px;
  background:rgba(26,29,39,.94);backdrop-filter:blur(14px);
  border:1px solid var(--border);border-radius:16px;
  display:flex;align-items:center;justify-content:space-between;gap:16px;
  box-shadow:0 14px 32px rgba(0,0,0,.26);
}
.settings-savebar-title{font-weight:800;color:#fff;font-size:.95rem;}
.settings-savebar-sub{font-size:.78rem;color:var(--muted);margin-top:2px;}
.settings-savebar .btn{padding:11px 18px;white-space:nowrap;}
.settings-tabs{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px;}
.settings-tab{
  border:1px solid var(--border);background:var(--surface);color:var(--muted);
  border-radius:999px;padding:10px 15px;font-size:.85rem;font-weight:800;
  cursor:pointer;display:flex;align-items:center;gap:8px;transition:all .15s;
}
.settings-tab:hover{background:var(--surface2);color:var(--text);}
.settings-tab.active{background:rgba(232,184,75,.18);border-color:rgba(232,184,75,.65);color:#fff;box-shadow:0 0 0 3px rgba(232,184,75,.12);}
.settings-section{display:none;}
.settings-section.active{display:block;}
.settings-section-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px;align-items:start;}
.settings-section-grid.single{grid-template-columns:minmax(0,900px);}
.settings-help{padding:14px 16px;border:1px solid rgba(232,184,75,.25);background:rgba(232,184,75,.10);border-radius:14px;color:#c7d2fe;font-size:.86rem;line-height:1.5;}
.mini-status-card{padding:14px;border:1px solid var(--border);border-radius:14px;background:var(--surface2);display:flex;flex-direction:column;gap:4px}.mini-status-card strong{color:#fff}.mini-status-card span{font-size:.78rem;color:var(--muted)}.status-pill{font-size:.72rem;font-weight:800;border:1px solid var(--border);border-radius:999px;padding:6px 10px;color:#cbd5e1;background:rgba(255,255,255,.04)}
@@media(max-width:1000px){.settings-section-grid{grid-template-columns:1fr}.settings-savebar{top:60px;align-items:flex-start;flex-direction:column}.settings-savebar .btn{width:100%;}}

/* ── Preset cards (Phase 3 — thèmes secteurs premium) ── */
.preset-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;}
.preset-card{
  position:relative;cursor:pointer;border-radius:16px;
  background:var(--surface2);border:2px solid var(--border);
  padding:18px 16px 14px 16px;display:flex;flex-direction:column;gap:12px;
  transition:all .18s ease;text-align:left;
}
.preset-card:hover{border-color:rgba(232,184,75,.55);transform:translateY(-2px);box-shadow:0 14px 30px rgba(0,0,0,.25);}
.preset-card.active{
  border-color:var(--accent);
  box-shadow:0 0 0 4px rgba(232,184,75,.20),0 14px 30px rgba(232,184,75,.25);
}
.preset-card .pc-icon{width:42px;height:42px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;color:#fff;}
.preset-card .pc-name{font-weight:800;color:#fff;font-size:1rem;line-height:1.2;}
.preset-card .pc-desc{font-size:.78rem;color:var(--muted);line-height:1.4;}
.preset-card .pc-swatches{display:flex;gap:5px;margin-top:auto;}
.preset-card .pc-swatch{width:18px;height:18px;border-radius:5px;border:1px solid rgba(255,255,255,.1);}
.preset-card .pc-active-tag{
  position:absolute;top:10px;right:10px;font-size:.65rem;font-weight:800;
  background:var(--accent);color:#1a1206;padding:3px 8px;border-radius:999px;
  display:none;letter-spacing:.04em;
}
.preset-card.active .pc-active-tag{display:inline-block;}
.preset-actions{display:flex;gap:10px;margin-top:14px;flex-wrap:wrap;}
.preset-actions .btn-ghost{flex:1;min-width:140px;}

/* ── Tables ── */
.data-table{width:100%;border-collapse:collapse;}
.data-table th{
  font-size:.72rem;text-transform:uppercase;letter-spacing:.5px;
  color:var(--muted);padding:10px 14px;border-bottom:1px solid var(--border);
  font-weight:600;text-align:left;
}
.data-table td{
  padding:12px 14px;border-bottom:1px solid rgba(255,255,255,.04);
  font-size:.87rem;color:var(--text);vertical-align:middle;
}
.data-table tr:last-child td{border-bottom:none;}
.data-table tr:hover td{background:rgba(255,255,255,.03);}

/* ── Badges ── */
.badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:.72rem;font-weight:700;}
.badge-green{background:rgba(34,197,94,.15);color:#86efac;}
.badge-red{background:rgba(239,68,68,.15);color:#fca5a5;}
.badge-blue{background:rgba(232,184,75,.2);color:#a5b4fc;}
.badge-yellow{background:rgba(245,158,11,.15);color:#fcd34d;}
.badge-gray{background:rgba(255,255,255,.08);color:var(--muted);}

/* ── Color swatch picker ── */
.color-row{display:flex;align-items:center;gap:10px;}
.color-swatch{width:36px;height:36px;border-radius:8px;border:2px solid var(--border);cursor:pointer;flex-shrink:0;}
.color-swatch-wide{width:100%;height:36px;}
/* Sélecteur d'emojis premium pour les services */
.emoji-picker{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;max-height:240px;overflow-y:auto;padding:10px;background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:12px;}
.emoji-cat{width:100%;font-size:.62rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;padding:6px 2px 2px;pointer-events:none;line-height:1;}
.emoji-opt{width:40px;height:40px;border-radius:10px;border:1px solid transparent;background:rgba(255,255,255,.05);font-size:20px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.12s;padding:0;}
.emoji-opt:hover{background:rgba(232,184,75,.15);transform:translateY(-2px);}
.emoji-opt.is-selected{border-color:var(--accent);background:rgba(232,184,75,.22);box-shadow:0 0 0 2px rgba(232,184,75,.25);}
.emoji-opt.emoji-none{font-size:16px;color:var(--muted);}
/* ── Modale Nouba (alert/confirm au thème de l'app) ── */
.nmodal-overlay{position:fixed;inset:0;z-index:99999;display:none;align-items:center;justify-content:center;background:rgba(2,6,18,.72);backdrop-filter:blur(6px);padding:20px;}
.nmodal-overlay.open{display:flex;animation:nmodalFade .18s ease;}
@@keyframes nmodalFade{from{opacity:0}to{opacity:1}}
.nmodal{width:min(440px,94vw);background:linear-gradient(160deg,var(--surface2),var(--surface));border:1px solid var(--border);border-radius:20px;padding:28px 26px 22px;box-shadow:0 30px 90px rgba(2,6,18,.7);text-align:center;animation:nmodalPop .22s cubic-bezier(.2,1.4,.4,1);}
@@keyframes nmodalPop{from{transform:scale(.9) translateY(10px);opacity:0}to{transform:scale(1) translateY(0);opacity:1}}
.nmodal-icon{font-size:42px;line-height:1;margin-bottom:12px;}
.nmodal-title{font-family:var(--font-display);font-size:1.25rem;font-weight:800;color:var(--text);margin-bottom:8px;}
.nmodal-message{font-size:.95rem;color:var(--muted);line-height:1.5;margin-bottom:22px;white-space:pre-line;}
.nmodal-actions{display:flex;gap:10px;justify-content:center;}
.nmodal-btn{flex:1;max-width:170px;padding:12px 18px;border-radius:13px;font-weight:800;font-size:.95rem;cursor:pointer;border:1px solid var(--border);transition:.15s;}
.nmodal-cancel{background:rgba(255,255,255,.05);color:var(--muted);}
.nmodal-cancel:hover{background:rgba(255,255,255,.1);color:var(--text);}
.nmodal-confirm{background:var(--accent);color:#1a1206;border-color:var(--accent);}
.nmodal-confirm:hover{background:var(--accent2);}
.nmodal.is-danger .nmodal-confirm{background:var(--danger);color:#fff;border-color:var(--danger);}
.nmodal.is-danger .nmodal-confirm:hover{filter:brightness(1.1);}
.nmodal.is-alert .nmodal-cancel{display:none;}
.nmodal.is-alert .nmodal-confirm{max-width:none;}

/* ── Service cards ── */
.service-card{
  background:var(--surface2);border:1px solid var(--border);border-radius:14px;
  padding:16px;display:flex;align-items:center;gap:14px;
  transition:border-color .2s;
}
.service-card:hover{border-color:rgba(255,255,255,.15);}
.service-dot{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;font-weight:800;flex-shrink:0;}
.service-info{flex:1;min-width:0;}
.service-name{font-weight:700;font-size:.92rem;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.service-code{font-size:.75rem;color:var(--muted);}
.service-actions{display:flex;gap:6px;flex-shrink:0;}

/* ── Agent row ── */
.agent-row{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--border);}
.agent-row:last-child{border-bottom:none;}
.agent-avatar{
  width:38px;height:38px;border-radius:10px;flex-shrink:0;
  background:linear-gradient(135deg,#b8862b,#b8862b);
  display:flex;align-items:center;justify-content:center;
  font-weight:800;font-size:.95rem;color:#fff;
}
.agent-info{flex:1;min-width:0;}
.agent-name{font-weight:700;font-size:.88rem;color:#fff;}
.agent-detail{font-size:.75rem;color:var(--muted);}

/* ── Stats bars ── */
.stat-bar{background:rgba(255,255,255,.07);border-radius:4px;height:6px;overflow:hidden;}
.stat-bar-fill{height:100%;border-radius:4px;background:var(--accent);transition:width .6s ease;}

/* ── Alert ── */
.alert{padding:12px 16px;border-radius:10px;font-size:.84rem;margin-bottom:16px;}
.alert-success{background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.25);color:#86efac;}
.alert-danger{background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.25);color:#fca5a5;}

/* ── Toggle ── */
.toggle{display:flex;align-items:center;gap:10px;}
.toggle input[type=checkbox]{width:40px;height:22px;appearance:none;background:var(--surface3);border-radius:11px;cursor:pointer;position:relative;transition:background .2s;border:1px solid var(--border);flex-shrink:0;}
.toggle input[type=checkbox]::after{content:'';position:absolute;width:16px;height:16px;background:#fff;border-radius:50%;top:2px;left:2px;transition:transform .2s;}
.toggle input[type=checkbox]:checked{background:var(--accent);border-color:var(--accent);}
.toggle input[type=checkbox]:checked::after{transform:translateX(18px);}
.toggle label{color:var(--text);font-size:.85rem;font-weight:500;text-transform:none;letter-spacing:0;margin:0;cursor:pointer;}

/* ── Range slider ── */
input[type=range]{-webkit-appearance:none;width:100%;height:6px;border-radius:3px;background:var(--surface3);outline:none;}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:18px;height:18px;border-radius:50%;background:var(--accent);cursor:pointer;}

/* ── Divider ── */
.divider{border:none;border-top:1px solid var(--border);margin:20px 0;}

/* ── Section title ── */
.section-title{font-size:.8rem;font-weight:700;color:var(--accent2);text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:8px;}
.section-title::after{content:'';flex:1;height:1px;background:var(--border);}

/* ── Quick links ── */
.qlink{
  display:flex;align-items:center;gap:10px;padding:10px 14px;
  background:var(--surface2);border:1px solid var(--border);border-radius:10px;
  font-size:.84rem;font-weight:600;color:var(--text);transition:all .15s;
}
.qlink:hover{border-color:var(--accent);color:var(--accent2);}

/* ── Modal ── */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:200;display:none;align-items:center;justify-content:center;backdrop-filter:blur(4px);}
.modal-overlay.open{display:flex;}
.modal-box{background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:28px;width:min(560px,95vw);max-height:90vh;overflow-y:auto;}
.modal-title{font-size:1.05rem;font-weight:700;color:#fff;margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;}
.modal-close{background:none;border:none;color:var(--muted);font-size:1.2rem;cursor:pointer;padding:4px;}
.modal-close:hover{color:var(--text);}

/* ── Timeline ── */
.timeline-item{display:flex;gap:12px;padding:10px 0;border-bottom:1px solid var(--border);}
.timeline-item:last-child{border-bottom:none;}
.tl-dot{width:8px;height:8px;border-radius:50%;background:var(--accent);flex-shrink:0;margin-top:6px;}
.tl-ticket{font-weight:700;color:#fff;font-size:.88rem;}
.tl-meta{font-size:.75rem;color:var(--muted);}

/* ── Scrollbar ── */
::-webkit-scrollbar{width:6px;height:6px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:rgba(255,255,255,.12);border-radius:3px;}
::-webkit-scrollbar-thumb:hover{background:rgba(255,255,255,.2);}
</style>
</head>
