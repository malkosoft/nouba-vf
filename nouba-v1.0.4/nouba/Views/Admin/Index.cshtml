                        <p style="color:var(--muted);font-size:.84rem;margin:0">Le <strong>fournisseur</strong> a l'accès technique complet ; le <strong>client</strong> gère le métier.</p>
                        <div class="vstack gap-2">
                            @foreach (var acc in adminAccounts)
                            {
