function getSelectedVoiceGender(){
    var selected = document.querySelector('input[name="VoiceGender"]:checked');
    return selected ? selected.value : 'female';
}

function updateVoiceGenderAvailability(d){
    var ar = d && d.ar ? d.ar : {};
    var maleReady = !!ar.male;
    var femaleReady = !!ar.female;

    // v2.7.26 — Les cartes Féminin/Masculin restent TOUJOURS sélectionnables.
    // Le choix s'applique à l'arabe uniquement (FR/EN n'ayant qu'une voix
    // neurale Piper féminine). Avant, on désactivait la carte « Masculine »
    // si le modèle arabe masculin était absent, ce qui était trompeur :
    // l'utilisateur pensait que tout son système était bloqué.
    document.querySelectorAll('[data-voice-gender-card]').forEach(function(card){
        card.style.opacity = '1';
        card.style.cursor = 'pointer';
        card.title = '';
        var input = card.querySelector('input');
        if(input) input.disabled = false;
    });

    // Boutons de test arabe : on grise uniquement le test du genre indisponible.
    document.querySelectorAll('[data-test-voice-gender]').forEach(function(btn){
        var gender = btn.getAttribute('data-test-voice-gender');
        var ready = gender === 'male' ? maleReady : femaleReady;
        btn.disabled = !ready;
        btn.style.opacity = ready ? '1' : '.5';
        btn.title = ready ? '' : 'Modèle arabe ' + (gender==='male'?'masculin':'féminin') + ' non installé';
    });
}

function testVoice(lang, forcedGender){
    var text = lang === 'ar'
        ? 'التذكرة خمسة وعشرون، يرجى التوجه إلى الشباك ثلاثة'
        : lang === 'en'
            ? 'Ticket twenty five, please proceed to counter three.'
            : 'Ticket numero vingt-cinq, veuillez vous presenter au guichet numero trois.';
    var gender = forcedGender || getSelectedVoiceGender();
    if(lang === 'ar' && forcedGender === 'male' && window.lastTtsStatus && window.lastTtsStatus.ar && !window.lastTtsStatus.ar.male){
        setVoiceGenderStatus('Voix masculine arabe incompatible avec Piper.', false);
        return;
    }
    var baseUrl = '/Tts/Speak?lang=' + encodeURIComponent(lang) + '&gender=' + encodeURIComponent(gender) + '&text=' + encodeURIComponent(text);
    // Traduit l'en-tête X-Piper renvoyé par le serveur en message clair.
    function piperReason(r){
        var x = (r && r.headers && r.headers.get('X-Piper')) || '';
        if(x === 'model-missing') return 'Modèle Piper absent pour ' + lang.toUpperCase() + ' ' + (gender==='male'?'masculin':'féminin') + ' (déposez le .onnx + .onnx.json).';
        if(x === 'synth-failed')  return 'Piper a échoué à synthétiser ce texte (voir logs serveur). Réessayez ou changez la vitesse.';
        return 'Voix locale indisponible (HTTP ' + (r ? r.status : '?') + ').';
    }
    function attempt(retriesLeft){
        var bust = Date.now() + '_' + Math.random().toString(36).slice(2, 8);
        return fetch(baseUrl + '&v=' + bust, { cache: 'no-store' })
          .then(r=>{
              if(r.status===204 || !r.ok){
                  // Au démarrage à froid, le modèle peut ne pas être encore
                  // chargé : on retente une fois après une courte pause.
                  if(retriesLeft > 0){ return new Promise(function(res){ setTimeout(function(){ res(attempt(retriesLeft-1)); }, 900); }); }
                  throw new Error(piperReason(r));
              }
              return r.blob();
          });
    }
    attempt(1)
      .then(b=>{
          if(!b || !b.size) throw new Error('Le fichier vocal reçu est vide (Piper a renvoyé un WAV invalide).');
          var u=URL.createObjectURL(new Blob([b],{type:'audio/wav'})); var a=new Audio(u); a.onended=()=>URL.revokeObjectURL(u);
          return a.play()
            .then(function(){ setVoiceGenderStatus('Voix Piper OK (' + lang.toUpperCase() + ' ' + (gender==='male'?'masculin':'féminin') + ').', true); })
            .catch(function(){ setVoiceGenderStatus('Piper a bien généré le son, mais le navigateur a bloqué la lecture automatique. Cliquez d\'abord sur la page, puis réessayez.', false); });
      })
      .catch(e=>setVoiceGenderStatus(e && e.message ? e.message : 'Voix locale indisponible.', false));
}

