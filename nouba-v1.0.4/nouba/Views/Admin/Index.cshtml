    <div class="content">

    <!-- ═══ TAB: DASHBOARD ═══ -->
    <div class="tab-pane @(tab=="dashboard"?"active":"")" id="tab-dashboard">

        @{
            int[] hourly = ViewBag.HourlyBuckets as int[] ?? new int[24];
            int peakHour = (int)(ViewBag.PeakHour ?? -1);
            int peakHourCount = (int)(ViewBag.PeakHourCount ?? 0);
            int yTotal = (int)(ViewBag.YesterdayTotal ?? 0);
            int yServed = (int)(ViewBag.YesterdayServed ?? 0);
            double absRate = (double)(ViewBag.AbsenceRate ?? 0.0);
            string topSvc = ViewBag.TopServiceName as string ?? "—";
            int topSvcCount = (int)(ViewBag.TopServiceCount ?? 0);

            // Comparaison vs hier
            int diffTotal = totalToday - yTotal;
            string diffArrow = diffTotal > 0 ? "↗" : (diffTotal < 0 ? "↘" : "→");
            string diffColor = diffTotal > 0 ? "#22c55e" : (diffTotal < 0 ? "#ef4444" : "#94a3b8");
            int diffPct = yTotal > 0 ? (int)Math.Round((diffTotal * 100.0) / yTotal) : 0;

            // Donut data
            int donutTotal = Math.Max(1, totalToday);
            double pctServed  = servedToday * 100.0 / donutTotal;
            double pctWaiting = waitingNow  * 100.0 / donutTotal;
            double pctCalled  = calledNow   * 100.0 / donutTotal;
            double pctAbsent  = absentToday * 100.0 / donutTotal;
            // Stroke-dasharray sur cercle r=70 → C = 2πr ≈ 439.82
            double C = 2 * Math.PI * 70;
            double[] arcs = { pctServed, pctCalled, pctWaiting, pctAbsent };
            string[] arcColors = { "#22c55e", "#3b82f6", "#f59e0b", "#ef4444" };
            string[] arcLabels = { "Servis", "Appelés", "En attente", "Absents" };
            int[] arcCounts = { servedToday, calledNow, waitingNow, absentToday };

            // Hourly chart calc
            int hourlyMax = Math.Max(1, hourly.Max());
            int[] activeHours = Enumerable.Range(0, 24).Where(h => hourly[h] > 0).ToArray();
            int firstActive = activeHours.Length > 0 ? activeHours.First() : 8;
            int lastActive  = activeHours.Length > 0 ? activeHours.Last()  : 18;
            int chartFrom = Math.Min(7, firstActive);
            int chartTo   = Math.Max(20, lastActive);
        }

        <div class="kpi-grid">
