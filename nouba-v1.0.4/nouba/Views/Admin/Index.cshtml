        <!-- ── Insights premium : pic + service top + statut imprimante ── -->
        <div class="@(isProvider ? "grid-3" : "grid-2")" style="margin-bottom:20px;gap:16px">
            <div class="panel" style="background:linear-gradient(135deg,rgba(168,85,247,.12),rgba(232,184,75,.04));border-color:rgba(168,85,247,.25)">
                <div class="panel-body" style="display:flex;align-items:center;gap:14px;padding:18px">
                    <div style="width:48px;height:48px;border-radius:14px;background:rgba(168,85,247,.18);display:flex;align-items:center;justify-content:center;font-size:1.4rem">🔥</div>
                    <div style="flex:1;min-width:0">
                        <div style="font-size:.7rem;text-transform:uppercase;color:var(--muted);letter-spacing:.08em;font-weight:700">Pic d'activité</div>
                        <div style="font-size:1.25rem;font-weight:800;color:#fff">@(peakHour >= 0 ? $"{peakHour:00}h–{peakHour+1:00}h" : "—")</div>
                        <div style="font-size:.78rem;color:var(--muted)">@peakHourCount tickets sur 1h</div>
                    </div>
                </div>
            </div>
            <div class="panel" style="background:linear-gradient(135deg,rgba(34,197,94,.12),rgba(16,185,129,.04));border-color:rgba(34,197,94,.25)">
                <div class="panel-body" style="display:flex;align-items:center;gap:14px;padding:18px">
                    <div style="width:48px;height:48px;border-radius:14px;background:rgba(34,197,94,.18);display:flex;align-items:center;justify-content:center;font-size:1.4rem">⭐</div>
                    <div style="flex:1;min-width:0">
                        <div style="font-size:.7rem;text-transform:uppercase;color:var(--muted);letter-spacing:.08em;font-weight:700">Service le + demandé</div>
                        <div style="font-size:1.05rem;font-weight:800;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@topSvc</div>
                        <div style="font-size:.78rem;color:var(--muted)">@topSvcCount tickets</div>
                    </div>
                </div>
            </div>
            @if (isProvider)
            {
            <div class="panel" style="background:linear-gradient(135deg,@((bool)(ViewBag.PrinterEnabled ?? false)?"rgba(34,197,94,.12),rgba(16,185,129,.04)":"rgba(239,68,68,.10),rgba(239,68,68,.02)"));border-color:@((bool)(ViewBag.PrinterEnabled ?? false)?"rgba(34,197,94,.25)":"rgba(239,68,68,.25)")">
                <div class="panel-body" style="display:flex;align-items:center;gap:14px;padding:18px">
                    <div style="width:48px;height:48px;border-radius:14px;background:@((bool)(ViewBag.PrinterEnabled ?? false)?"rgba(34,197,94,.18)":"rgba(239,68,68,.18)");display:flex;align-items:center;justify-content:center;font-size:1.4rem">🖨️</div>
                    <div style="flex:1;min-width:0">
                        <div style="font-size:.7rem;text-transform:uppercase;color:var(--muted);letter-spacing:.08em;font-weight:700">Imprimante</div>
                        <div style="font-size:1.05rem;font-weight:800;color:#fff">@((ViewBag.PrintMode as string ?? "all").ToUpperInvariant()) <span style="font-size:.7rem;color:var(--muted)">@((bool)(ViewBag.PrinterEnabled ?? false)?"active":"inactive")</span></div>
                        <div style="font-size:.78rem;color:var(--muted)">@(ViewBag.PrinterIp)<span style="opacity:.5">:@(ViewBag.PrinterPort)</span> · <a href="?tab=printer" style="color:var(--accent2);text-decoration:underline">configurer</a></div>
                    </div>
                </div>
            </div>
            }
        </div>

        <!-- ── Widget IA : Résumé intelligent du jour (100% offline) ── -->
        <div class="panel" style="margin-bottom:20px;background:linear-gradient(135deg,rgba(168,85,247,.08),rgba(59,130,246,.04));border-color:rgba(168,85,247,.25)">
            <div class="panel-header" style="border-color:rgba(168,85,247,.2)">
                <h2><i class="bi bi-stars me-2" style="color:#c084fc"></i>Résumé IA <span style="font-size:.65rem;background:rgba(168,85,247,.15);color:#c084fc;padding:2px 8px;border-radius:6px;margin-left:8px;text-transform:uppercase;letter-spacing:.05em;font-weight:700">100% offline</span></h2>
                <p>Analyse automatique de votre journée — pic, top service, agent le plus rapide</p>
            </div>
            <div class="panel-body">
                <div id="aiSummaryBoxQuick" style="font-size:.92rem;color:#e2e8f0;line-height:1.65;min-height:60px;padding:12px 14px;background:rgba(15,23,42,.5);border:1px solid var(--border);border-radius:12px;margin-bottom:12px">
                    <span style="color:var(--muted)">⏳ Génération du résumé en cours…</span>
                </div>
                <div id="aiRecommendationsQuick" style="margin-bottom:12px"></div>
                <div style="display:flex;gap:8px;flex-wrap:wrap">
                    <button type="button" class="btn btn-ghost" onclick="loadAiSummaryQuick()">
                        <i class="bi bi-arrow-clockwise"></i> Actualiser
                    </button>
                    <a href="/Ai/Report" target="_blank" class="btn btn-ghost">
                        <i class="bi bi-file-text"></i> Voir le rapport texte complet
                    </a>
                    <button type="button" class="btn btn-ghost" onclick="copyAiReport()">
                        <i class="bi bi-clipboard"></i> Copier le rapport
                    </button>
                </div>
            </div>
        </div>
        <script>
            async function loadAiSummaryQuick(){
                try {
                    var r = await fetch('/Ai/Summary');
                    var s = await r.json();
                    var box = document.getElementById('aiSummaryBoxQuick');
                    var recs = document.getElementById('aiRecommendationsQuick');
                    box.innerHTML = '<i class="bi bi-magic" style="color:#c084fc;margin-right:6px"></i>' + (s.headlineFr || 'Aucune donnée.');
                    if(s.recommendations && s.recommendations.length){
                        recs.innerHTML = '<div style="font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:#fbbf24;font-weight:700;margin-bottom:6px"><i class="bi bi-lightbulb"></i> Recommandations</div>' +
                            s.recommendations.map(function(r){
                                return '<div style="padding:8px 12px;background:rgba(245,158,11,.06);border-left:3px solid #fbbf24;border-radius:6px;margin-bottom:5px;font-size:.84rem;color:#fde68a">' + r + '</div>';
                            }).join('');
                    } else { recs.innerHTML = ''; }
                } catch(e){
                    document.getElementById('aiSummaryBoxQuick').innerHTML = '<span style="color:#fca5a5">Erreur : ' + e.message + '</span>';
                }
            }
            async function copyAiReport(){
                try {
                    var r = await fetch('/Ai/Report');
                    var t = await r.text();
                    await navigator.clipboard.writeText(t);
                    window.noubaAlert('Rapport copié dans le presse-papier.');
                } catch(e){ window.noubaAlert('Erreur : ' + e.message, { error:true }); }
            }
            // Auto-charger au chargement du dashboard
            if(document.getElementById('aiSummaryBoxQuick')) loadAiSummaryQuick();
        </script>

        <!-- ── Graphique horaire + Donut ── -->
        <div class="grid-2" style="margin-bottom:20px">
            <div class="panel">
                <div class="panel-header">
                    <h2><i class="bi bi-graph-up me-2" style="color:var(--accent)"></i>Volume horaire</h2>
                    <p>Tickets créés par heure aujourd'hui</p>
                </div>
                <div class="panel-body">
                    @{
                        int chartW = 600; int chartH = 220;
                        int leftPad = 32, rightPad = 12, topPad = 14, bottomPad = 28;
                        int innerW = chartW - leftPad - rightPad;
                        int innerH = chartH - topPad - bottomPad;
                        int hours = chartTo - chartFrom + 1;
                        var inv = System.Globalization.CultureInfo.InvariantCulture;
                        var ptsList = new List<(double x, double y, int v, int h)>();
                        for (int i = 0; i < hours; i++)
                        {
                            int h = chartFrom + i;
                            int v = (h < 0 || h > 23) ? 0 : hourly[h];
                            double x = leftPad + (i + 0.5) * (innerW / (double)hours);
                            double y = topPad + innerH - (v / (double)hourlyMax) * innerH;
                            ptsList.Add((x, y, v, h));
                        }
                        string polyPtsStr = string.Join(" ", ptsList.Select(p => $"{p.x.ToString("F1", inv)},{p.y.ToString("F1", inv)}"));
                        var sb = new System.Text.StringBuilder();
                        sb.Append($"M {leftPad.ToString(inv)},{(topPad + innerH).ToString(inv)}");
                        foreach (var p in ptsList) sb.Append($" L {p.x.ToString("F1", inv)},{p.y.ToString("F1", inv)}");
                        sb.Append($" L {(chartW - rightPad).ToString(inv)},{(topPad + innerH).ToString(inv)} Z");
                        string areaPathStr = sb.ToString();
                    }
                    <svg viewBox="0 0 600 220" preserveAspectRatio="none" style="width:100%;height:220px;display:block">
                        <defs>
                            <linearGradient id="hourlyGrad" x1="0" x2="0" y1="0" y2="1">
                                <stop offset="0%" stop-color="#e8b84b" stop-opacity=".7"/>
                                <stop offset="100%" stop-color="#e8b84b" stop-opacity=".05"/>
                            </linearGradient>
                        </defs>
                        @for (int g = 0; g < 4; g++)
                        {
                            double y = topPad + (innerH * g / 4.0);
                            <line x1="@leftPad" y1="@(y.ToString("F1", inv))" x2="@(chartW-rightPad)" y2="@(y.ToString("F1", inv))" stroke="rgba(255,255,255,.06)" stroke-width="1"/>
                        }
                        <path d="@areaPathStr" fill="url(#hourlyGrad)" stroke="none"/>
                        <polyline points="@polyPtsStr" fill="none" stroke="#f3d486" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                        @foreach (var p in ptsList.Where(p => p.v > 0))
                        {
                            <circle cx="@(p.x.ToString("F1", inv))" cy="@(p.y.ToString("F1", inv))" r="3" fill="#a5b4fc"><title>@p.h.ToString("00")h : @p.v ticket(s)</title></circle>
                        }
                        @for (int i = 0; i < hours; i += 2)
                        {
                            int hh = chartFrom + i;
                            double xx = leftPad + (i + 0.5) * (innerW / (double)hours);
                            @Html.Raw($"<text x=\"{xx.ToString("F1", inv)}\" y=\"{chartH - 8}\" text-anchor=\"middle\" font-size=\"10\" fill=\"#64748b\" font-family=\"system-ui\">{hh:00}h</text>")
                        }
                        @Html.Raw($"<text x=\"6\" y=\"{topPad + 4}\" font-size=\"10\" fill=\"#64748b\" font-family=\"system-ui\">{hourlyMax}</text>")
                        @Html.Raw($"<text x=\"6\" y=\"{topPad + innerH - 2}\" font-size=\"10\" fill=\"#64748b\" font-family=\"system-ui\">0</text>")
                    </svg>
                </div>
            </div>

            <div class="panel">
                <div class="panel-header">
                    <h2><i class="bi bi-pie-chart me-2" style="color:var(--accent)"></i>Répartition des statuts</h2>
                    <p>Tickets aujourd'hui par état</p>
                </div>
                <div class="panel-body" style="display:flex;align-items:center;gap:24px;flex-wrap:wrap;justify-content:center">
                    @{
                        double accumDonut = 0;
                        var donutArcs = new List<(double dash, double gap, double offset, string color)>();
                        for (int i = 0; i < 4; i++)
                        {
                            double dash = (arcs[i] / 100.0) * C;
                            donutArcs.Add((dash, C - dash, -accumDonut, arcColors[i]));
                            accumDonut += dash;
                        }
                    }
                    <svg viewBox="0 0 200 200" style="width:200px;height:200px;flex-shrink:0">
                        <circle cx="100" cy="100" r="70" fill="none" stroke="rgba(255,255,255,.06)" stroke-width="22"/>
                        @foreach (var (dash, gap, offset, color) in donutArcs)
                        {
                            <circle cx="100" cy="100" r="70" fill="none" stroke="@color" stroke-width="22" stroke-dasharray="@(dash.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)) @(gap.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))" stroke-dashoffset="@(offset.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))" transform="rotate(-90 100 100)" stroke-linecap="butt"/>
                        }
                        <text x="100" y="96" text-anchor="middle" font-size="36" font-weight="800" fill="#fff" font-family="system-ui">@totalToday</text>
                        <text x="100" y="118" text-anchor="middle" font-size="11" fill="#94a3b8" font-family="system-ui">tickets</text>
                    </svg>
                    <div style="display:flex;flex-direction:column;gap:8px;min-width:120px">
                        @for (int i = 0; i < 4; i++)
                        {
                            <div style="display:flex;align-items:center;gap:8px;font-size:.85rem">
                                <span style="width:10px;height:10px;border-radius:50%;background:@arcColors[i];flex-shrink:0"></span>
                                <span style="color:var(--muted);min-width:78px">@arcLabels[i]</span>
                                <span style="color:#fff;font-weight:700">@arcCounts[i]</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="grid-2">
            <!-- Par service -->
            <div class="panel">
                <div class="panel-header">
                    <h2><i class="bi bi-bar-chart me-2" style="color:var(--accent)"></i>Activité par service</h2>
                    <p>Aujourd'hui</p>
                </div>
                <div class="panel-body">
                    @{
                        var serviceStats = ViewBag.ServiceStats as dynamic ?? new List<dynamic>();
                        var maxTotal = 1;
                        foreach (var s in serviceStats) { if ((int)s.Total > maxTotal) maxTotal = (int)s.Total; }
                    }
                    @foreach (var s in serviceStats)
                    {
                        var pct = maxTotal > 0 ? (int)((double)(int)s.Total / maxTotal * 100) : 0;
                        <div style="margin-bottom:16px;">
                            <div style="display:flex;justify-content:space-between;margin-bottom:6px;align-items:center;">
                                <div style="display:flex;align-items:center;gap:8px;">
                                    <div style="width:10px;height:10px;border-radius:50%;background:@s.Service.ButtonColor;"></div>
                                    <span style="font-size:.85rem;font-weight:600;color:#fff;">@s.Service.Name</span>
                                </div>
                                <div style="display:flex;gap:8px;">
                                    <span class="badge badge-blue">@s.Total total</span>
                                    <span class="badge badge-green">@s.Served servis</span>
                                    @if ((int)s.Absent > 0) { <span class="badge badge-red">@s.Absent abs.</span> }
                                </div>
                            </div>
                            <div class="stat-bar"><div class="stat-bar-fill" style="width:@pct%;background:@s.Service.ButtonColor;"></div></div>
                        </div>
                    }
                    @if (!((IEnumerable<dynamic>)serviceStats).Any())
                    {
                        <p style="color:var(--muted);text-align:center;padding:20px 0;font-size:.85rem;">Aucune activité aujourd'hui.</p>
                    }
                </div>
            </div>

            <!-- Appels récents -->
            <div class="panel">
                <div class="panel-header">
                    <h2><i class="bi bi-clock-history me-2" style="color:var(--accent)"></i>Appels récents</h2>
                    <p>@recentCalls.Count dernier(s)</p>
                </div>
                <div class="panel-body" style="max-height:380px;overflow-y:auto;">
                    @foreach (var c in recentCalls)
                    {
                        <div class="timeline-item">
                            <div class="tl-dot"></div>
                            <div>
                                <div class="tl-ticket">@c.TicketNumber <span style="font-weight:400;color:var(--muted);">→ @c.CounterName</span></div>
                                <div class="tl-meta">@c.ServiceName · @c.CalledAt.ToString("HH:mm:ss")</div>
                            </div>
                        </div>
                    }
                    @if (!recentCalls.Any())
                    {
                        <p style="color:var(--muted);text-align:center;padding:20px 0;font-size:.85rem;">Aucun appel aujourd'hui.</p>
                    }
                </div>
            </div>
        </div>
        <div class="panel" style="margin-top:20px;">
            <div class="panel-header"><h2>Performance des agents</h2><p>Statistiques par agent (Nom Prénom)</p></div>
            <div class="panel-body">
                <div style="overflow:auto;">
                    <table style="width:100%;border-collapse:collapse;">
