function applyTheme(v){
    var t=themes[v];if(!t)return;
    // 1) Mettre à jour le champ caché ThemePreset (POST côté serveur)
    var hidden=document.getElementById('ThemePresetInput');
    if(hidden) hidden.value=v;
    // 2) Couleurs
    var map={DisplayAccentColor:t.accent,DisplayCardColor:t.card,DisplayHistoryColor:t.hist,DisplayFooterColor:t.footer};
    for(var k in map){
        var c=document.getElementById('col_'+k);
        if(c){c.value=map[k];}
    }
    // 3) Ambiance audio — vitesse et pitch adaptés au secteur
    var rate=document.querySelector('input[name="VoiceRate"]');
    var rateLabel=document.getElementById('rateVal');
    if(rate){ rate.value=t.rate; if(rateLabel) rateLabel.textContent=parseFloat(t.rate).toFixed(2); }
    var pitch=document.querySelector('input[name="VoicePitch"]');
    var pitchLabel=document.getElementById('pitchVal');
    if(pitch){ pitch.value=t.pitch; if(pitchLabel) pitchLabel.textContent=parseFloat(t.pitch).toFixed(1); }
    // 4) Marquer la carte active
    document.querySelectorAll('.preset-card').forEach(function(card){
        card.classList.toggle('active', card.getAttribute('data-preset') === v);
    });
}
