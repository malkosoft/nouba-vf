}

// ── Widget temps réel : statut imprimante via SignalR ──
function initPrinterStatusWidget(){
    var dot = document.getElementById('topPrinterDot');
    var lbl = document.getElementById('topPrinterLabel');
    if(!dot || !lbl) return;

    function apply(s){
        var ok = s.online && s.paperOk && !s.coverOpen;
        var warn = s.online && (s.paperNearEnd && s.paperOk && !s.coverOpen);
        var color = ok ? '#22c55e' : (warn ? '#fbbf24' : '#ef4444');
        var label;
        if (!s.online)        label = 'Imprimante hors ligne';
        else if (s.coverOpen) label = 'Capot ouvert';
        else if (!s.paperOk)  label = 'MANQUE PAPIER';
        else if (s.paperNearEnd) label = 'Papier presque fini';
        else                  label = 'Imprimante OK';
        dot.style.background = color;
        dot.style.boxShadow  = '0 0 10px ' + color;
        lbl.textContent = label;
        // Son d'alerte si défaut critique (et balise présente)
        if(!ok && !warn) {
            var sound = document.getElementById('alertSound');
            if(sound){ try{ sound.currentTime=0; sound.play(); }catch(e){} }
            dot.classList.add('blink');
        } else {
            dot.classList.remove('blink');
        }
    }

    // Polling fallback toutes les 20s (si SignalR non connecté)
    function poll(){
        fetch('/Printer/Status', {cache:'no-store'})
            .then(r=>r.json()).then(apply).catch(()=>{});
    }
    poll();
    setInterval(poll, 20000);

    // SignalR : écoute "PrinterStatus" (push immédiat)
    if (window.signalR) {
        var conn = new signalR.HubConnectionBuilder().withUrl('/queueHub').withAutomaticReconnect().build();
        conn.on('PrinterStatus', apply);
        conn.start().catch(function(){});
    }
}
