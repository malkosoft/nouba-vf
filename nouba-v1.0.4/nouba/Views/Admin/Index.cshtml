                <script>
                    function setNetworkPreset(mode){
                        var input = document.getElementById('serverUrlInput');
                        var port = (input.value.match(/:(\d+)$/) || [,5000])[1];
                        if(mode === 'local')      input.value = 'http://127.0.0.1:' + port;
                        if(mode === 'lan-any')    input.value = 'http://0.0.0.0:'   + port;
                        if(mode === 'lan-fixed')  input.value = 'http://192.168.1.50:' + port;
                        // Update visual selection
                        document.querySelectorAll('.net-mode-btn').forEach(function(b){
                            b.style.borderColor = 'var(--border)'; b.style.background = 'var(--surface2)';
                        });
                        var sel = document.querySelector('.net-mode-btn[data-mode="' + mode + '"]');
                        if(sel){
                            var color = mode === 'local' ? '#fbbf24' : (mode === 'lan-any' ? '#34d399' : '#f3d486');
                            var rgba  = mode === 'local' ? '251,191,36' : (mode === 'lan-any' ? '52,211,153' : '167,139,250');
                            sel.style.borderColor = color; sel.style.background = 'rgba(' + rgba + ',.15)';
                        }
                    }
                    function useDetectedIp(ip){
                        var input = document.getElementById('serverUrlInput');
                        var port = (input.value.match(/:(\d+)$/) || [,5000])[1];
                        input.value = 'http://' + ip + ':' + port;
                        setNetworkPreset('lan-fixed');
                    }
                    function testServerUrl(){
                        var v = document.getElementById('serverUrlInput').value;
                        try { var u = new URL(v); window.noubaAlert('URL valide\n\nHôte : ' + u.hostname + '\nPort : ' + u.port); }
                        catch (e) { window.noubaAlert('URL invalide.\n\nFormat attendu : http://192.168.1.50:5000', { error:true }); }
                    }
                </script>

