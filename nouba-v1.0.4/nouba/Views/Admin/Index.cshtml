                                    </form>
                                    <form asp-action="DeleteAdminAccount" method="post" style="margin:0" data-confirm="Supprimer le compte @acc.Username ?" data-confirm-danger="1" data-confirm-title="Supprimer un compte">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@acc.Id"/>
                                        <button type="submit" class="btn btn-ghost" style="padding:6px 10px;color:#fca5a5" title="Supprimer"><i class="bi bi-trash3"></i></button>
                                    </form>
                                </div>
                                <form asp-action="ResetAdminPassword" method="post" style="margin:0;display:flex;gap:8px;align-items:center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@acc.Id"/>
                                    <input class="form-control" name="newPassword" type="password" placeholder="Nouveau mot de passe pour @acc.Username" style="flex:1"/>
                                    <button type="submit" class="btn btn-ghost" style="white-space:nowrap"><i class="bi bi-key"></i> Réinitialiser</button>
                                </form>
                            }
                        </div>
                        <hr style="border-color:var(--border);opacity:.4"/>
                        <form asp-action="CreateAdminAccount" method="post" class="vstack gap-3">
                            @Html.AntiForgeryToken()
                            <div style="font-weight:700;color:#cbd5e1"><i class="bi bi-person-plus me-1"></i>Nouveau compte</div>
                            <div class="grid-2" style="gap:12px;">
                                <div><label>Nom complet</label><input class="form-control" name="fullName" placeholder="Nom de l'administrateur"/></div>
                                <div><label>Identifiant</label><input class="form-control" name="login" placeholder="identifiant"/></div>
                            </div>
                            <div class="grid-2" style="gap:12px;">
                                <div><label>Mot de passe</label><input class="form-control" name="password" type="password" placeholder="••••••••"/></div>
                                <div><label>Rôle</label>
                                    <select class="form-control" name="role">
                                        <option value="client" selected>Client (métier)</option>
                                        <option value="fournisseur">Fournisseur (technique)</option>
                                    </select>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary btn-w"><i class="bi bi-person-plus"></i> Créer le compte</button>
                        </form>
                    </div>
                </div>
                }

                <div class="panel" style="border-color:rgba(239,68,68,.3);">
                    <div class="panel-header" style="border-color:rgba(239,68,68,.2);">
                        <h2 style="color:#fca5a5;"><i class="bi bi-exclamation-triangle me-2"></i>Zone dangereuse</h2>
                    </div>
                    <div class="panel-body vstack gap-3">
                        <p style="color:var(--muted);font-size:.84rem;">Ces actions sont irréversibles. Utilisez avec précaution.</p>
                        <form asp-action="ResetDay" method="post" data-confirm="Supprimer TOUS les tickets du jour ?&#10;&#10;Cette action est irréversible." data-confirm-danger="1" data-confirm-title="Réinitialiser la journée">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-w">
                                <i class="bi bi-trash3"></i> Réinitialiser la journée
                            </button>
                        </form>
                        <form asp-action="UpdateSettings" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
