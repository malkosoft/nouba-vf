                                    <div style="flex:1;min-width:160px">
                                        <div style="font-weight:700;color:#e2e8f0">@acc.FullName</div>
                                        <div style="font-size:.78rem;color:var(--muted)">@acc.Username</div>
                                    </div>
                                    <span class="nav-badge" style="background:@(acc.Role == "fournisseur" ? "#f59e0b" : "#3b82f6")">@(acc.Role == "fournisseur" ? "FOURNISSEUR" : "CLIENT")</span>
                                    <span class="nav-badge" style="background:@(acc.IsActive ? "#22c55e" : "#64748b")">@(acc.IsActive ? "ACTIF" : "INACTIF")</span>
