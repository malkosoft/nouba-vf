                            <input type="hidden" name="SiteName" value="@settings.SiteName"/>
                            <button type="submit" class="btn @(settings.TicketsClosed?"btn-success":"btn-danger") btn-w">
                                <i class="bi @(settings.TicketsClosed?"bi-door-open":"bi-door-closed")"></i>
                                @(settings.TicketsClosed ? "Rouvrir la prise de tickets" : "Fermer la prise de tickets")
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            @if (isProvider)
            {
            <div class="vstack gap-4">
                <div class="panel" style="border-color:rgba(232,184,75,.3)">
                    <div class="panel-header" style="border-color:rgba(232,184,75,.2)">
                        <h2><i class="bi bi-shield-check me-2" style="color:#f3d486"></i>Licence</h2>
                    </div>
                    <div class="panel-body">
                        @{
                            bool licValid = (bool)(ViewBag.LicenseValid ?? false);
                            int daysRemaining = (int)(ViewBag.LicenseDaysRemaining ?? 0);
                            bool expiringSoon = (bool)(ViewBag.LicenseExpiringSoon ?? false);
                            int maxAgents = (int)(ViewBag.LicenseMaxAgents ?? 0);
                            int activeAgents = (int)(ViewBag.LicenseActiveAgents ?? 0);
                            int configuredAgents = (int)(ViewBag.LicenseConfiguredAgents ?? 0);
                            DateTime? expiresAt = ViewBag.LicenseExpiresAt as DateTime?;
                            DateTime? issuedAt = ViewBag.LicenseIssuedAt as DateTime?;
                            string licClient = ViewBag.LicenseClient as string ?? "—";
                            string licProduct = ViewBag.LicenseProduct as string ?? "Nouba Pro";
                        }

                        @if(licValid)
                        {
                            <div style="display:flex;align-items:center;gap:10px;padding:12px 14px;background:linear-gradient(135deg,rgba(16,185,129,.10),rgba(16,185,129,.04));border:1px solid rgba(16,185,129,.25);border-radius:12px;margin-bottom:16px">
                                <span style="position:relative;display:inline-flex;align-items:center;justify-content:center;width:14px;height:14px">
                                    <span style="position:absolute;width:14px;height:14px;border-radius:50%;background:#10b981;opacity:.4;animation:pulse 2s ease-out infinite"></span>
                                    <span style="position:relative;width:8px;height:8px;border-radius:50%;background:#10b981;box-shadow:0 0 12px #10b981"></span>
                                </span>
                                <span style="font-size:.86rem;font-weight:700;color:#34d399">Licence active — installation autorisée</span>
                            </div>
                            <style>
                                @@keyframes pulse {
                                    0% { transform: scale(1); opacity: .6; }
                                    100% { transform: scale(2.4); opacity: 0; }
                                }
                            </style>

                            <!-- Grille de propriétés de la licence -->
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px">
                                <!-- Validité -->
                                <div style="background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:10px;padding:10px 12px">
                                    <div style="font-size:.68rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);font-weight:700;margin-bottom:4px">
                                        <i class="bi bi-calendar-check me-1"></i>Validité
                                    </div>
                                    @if (daysRemaining > 30)
                                    {
                                        <div style="font-size:1.1rem;font-weight:800;color:#34d399;line-height:1.2">@daysRemaining <span style="font-size:.7rem;font-weight:600;color:var(--muted)">jours</span></div>
                                    }
                                    else if (daysRemaining > 7)
                                    {
                                        <div style="font-size:1.1rem;font-weight:800;color:#fbbf24;line-height:1.2">@daysRemaining <span style="font-size:.7rem;font-weight:600;color:var(--muted)">jours</span></div>
                                    }
                                    else if (daysRemaining >= 0)
                                    {
                                        <div style="font-size:1.1rem;font-weight:800;color:#fb7185;line-height:1.2">@daysRemaining <span style="font-size:.7rem;font-weight:600;color:var(--muted)">jour(s)</span></div>
                                    }
                                    else
                                    {
                                        <div style="font-size:1.1rem;font-weight:800;color:#ef4444;line-height:1.2">Expirée</div>
                                    }
                                    @if (expiresAt.HasValue)
                                    {
                                        <div style="font-size:.7rem;color:var(--muted);margin-top:2px">jusqu'au @expiresAt.Value.ToString("dd/MM/yyyy")</div>
                                    }
                                </div>

                                <!-- Agents -->
                                <div style="background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:10px;padding:10px 12px">
                                    <div style="font-size:.68rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);font-weight:700;margin-bottom:4px">
                                        <i class="bi bi-people me-1"></i>Agents
                                    </div>
                                    @{
                                        bool overConfigured = configuredAgents > maxAgents;
                                        bool overActive = activeAgents > maxAgents;
                                        string agentColor = overActive ? "#ef4444" : (overConfigured ? "#fbbf24" : "#34d399");
                                    }
                                    <div style="font-size:1.1rem;font-weight:800;line-height:1.2;color:@agentColor">
                                        @activeAgents<span style="color:var(--muted);font-weight:600">/@maxAgents</span>
                                    </div>
                                    <div style="font-size:.7rem;color:var(--muted);margin-top:2px">
                                        actifs · @configuredAgents configuré@(configuredAgents > 1 ? "s" : "")
                                    </div>
                                </div>
                            </div>

                            @if (expiringSoon && daysRemaining >= 0)
                            {
                                <div style="display:flex;align-items:center;gap:8px;padding:8px 12px;background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.2);border-radius:10px;margin-bottom:12px;font-size:.76rem;color:#fbbf24;line-height:1.5">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    <span>Votre licence expire dans <strong>@daysRemaining jour@(daysRemaining > 1 ? "s" : "")</strong>. Contactez votre revendeur pour renouveler.</span>
                                </div>
                            }
                            @if (overActive)
                            {
                                <div style="display:flex;align-items:center;gap:8px;padding:8px 12px;background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2);border-radius:10px;margin-bottom:12px;font-size:.76rem;color:#fca5a5;line-height:1.5">
                                    <i class="bi bi-x-octagon"></i>
                                    <span>Limite de licence dépassée : <strong>@activeAgents</strong> agents actifs pour <strong>@maxAgents</strong> autorisés.</span>
                                </div>
                            }

                            <!-- Détails (titulaire + dates) -->
                            <div style="background:rgba(255,255,255,.02);border:1px solid var(--border);border-radius:10px;padding:10px 12px;margin-bottom:12px">
                                <div style="display:flex;justify-content:space-between;gap:8px;font-size:.76rem;padding:3px 0">
                                    <span style="color:var(--muted)">Titulaire</span>
                                    <span style="font-weight:700;color:#cbd5e1;text-align:right">@licClient</span>
                                </div>
                                <div style="display:flex;justify-content:space-between;gap:8px;font-size:.76rem;padding:3px 0">
                                    <span style="color:var(--muted)">Produit</span>
                                    <span style="font-weight:700;color:#cbd5e1">@licProduct</span>
                                </div>
                                @if (issuedAt.HasValue)
                                {
                                    <div style="display:flex;justify-content:space-between;gap:8px;font-size:.76rem;padding:3px 0">
                                        <span style="color:var(--muted)">Émise le</span>
                                        <span style="font-weight:700;color:#cbd5e1">@issuedAt.Value.ToString("dd/MM/yyyy")</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div style="display:flex;align-items:center;gap:10px;padding:12px 14px;background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2);border-radius:12px;margin-bottom:14px">
                                <i class="bi bi-exclamation-triangle" style="font-size:1.1rem;color:#fca5a5"></i>
                                <span style="font-size:.85rem;font-weight:700;color:#fca5a5">Licence non activée</span>
                            </div>
                            <p style="font-size:.78rem;color:var(--muted);line-height:1.5;margin-bottom:12px">
                                Cette installation n'est pas activée. Communiquez l'identifiant machine ci-dessous à votre revendeur pour obtenir une clé.
                            </p>
                        }

                        <div style="color:var(--muted);font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;font-weight:700;margin-bottom:4px">
                            <i class="bi bi-fingerprint me-1"></i>Identifiant machine
                        </div>
                        <div id="licMachineIdBox" style="display:flex;align-items:center;gap:8px;font-family:'Courier New',monospace;font-size:.82rem;background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:8px;padding:8px 12px;letter-spacing:.1em;color:#cbd5e1">
                            <span id="licMachineIdValue" style="flex:1">@ViewBag.LicenseMachineId</span>
                            <button type="button" onclick="copyLicMid()" title="Copier" style="background:none;border:0;color:#94a3b8;cursor:pointer;padding:2px 6px;border-radius:6px">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </div>
                        <script>
                            function copyLicMid(){
                                var v = document.getElementById('licMachineIdValue').textContent.trim();
                                navigator.clipboard.writeText(v).then(function(){
                                    var b = document.getElementById('licMachineIdBox');
                                    var old = b.style.borderColor;
                                    b.style.borderColor = 'rgba(16,185,129,.5)';
                                    setTimeout(function(){ b.style.borderColor = old; }, 1200);
                                });
                            }
                        </script>
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-header"><h2><i class="bi bi-info-circle me-2" style="color:var(--accent)"></i>Informations système</h2></div>
                    <div class="panel-body">
                        <table class="data-table">
                            <tr><td style="color:var(--muted);">Version</td><td><span class="badge badge-blue">@ViewBag.ProductVersion</span></td></tr>
                            <tr><td style="color:var(--muted);">Framework</td><td>.NET 8 · ASP.NET Core</td></tr>
                            <tr><td style="color:var(--muted);">Base de données</td><td>SQLite (offline)</td></tr>
                            <tr><td style="color:var(--muted);">Temps réel</td><td>Synchronisation instantanée</td></tr>
                            <tr><td style="color:var(--muted);">Langues</td><td>FR · AR · TZ · EN</td></tr>
                            <tr><td style="color:var(--muted);">Services actifs</td><td>@Model.Count(s=>s.IsActive) / @Model.Count</td></tr>
                            <tr><td style="color:var(--muted);">Guichets actifs</td><td>@counters.Count(c=>c.IsActive) / @counters.Count</td></tr>
                            <tr><td style="color:var(--muted);">Agents actifs</td><td>@agents.Count(a=>a.IsActive) / @agents.Count</td></tr>
                        </table>
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-header"><h2><i class="bi bi-hdd me-2" style="color:var(--accent)"></i>Données &amp; Sauvegardes</h2></div>
                    <div class="panel-body vstack gap-3">
                        <div>
                            <div style="color:var(--muted);font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:4px">Base de données</div>
                            <div style="font-family:monospace;font-size:.78rem;background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:10px;padding:8px 12px;word-break:break-all;color:#94a3b8">@ViewBag.DatabasePath</div>
                        </div>
                        <div>
                            <div style="color:var(--muted);font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:4px">Dossier sauvegardes</div>
                            <div style="font-family:monospace;font-size:.78rem;background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:10px;padding:8px 12px;word-break:break-all;color:#94a3b8">@ViewBag.BackupsPath</div>
                        </div>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                            <div style="background:rgba(16,185,129,.08);border:1px solid rgba(16,185,129,.2);border-radius:10px;padding:10px 14px;text-align:center">
                                <div style="font-size:1.4rem;font-weight:800;color:#34d399">@ViewBag.BackupCount</div>
                                <div style="font-size:.72rem;color:var(--muted)">Sauvegardes stockées</div>
                            </div>
                            <div style="background:rgba(37,99,235,.08);border:1px solid rgba(37,99,235,.2);border-radius:10px;padding:10px 14px;text-align:center">
                                <div style="font-size:.78rem;font-weight:700;color:#60a5fa">@ViewBag.LastBackupDate</div>
                                <div style="font-size:.72rem;color:var(--muted)">Dernière sauvegarde</div>
                            </div>
                        </div>
                        <div style="background:rgba(245,158,11,.06);border:1px solid rgba(245,158,11,.18);border-radius:10px;padding:10px 14px;font-size:.78rem;color:#fbbf24;line-height:1.5">
                            <i class="bi bi-info-circle me-1"></i> Sauvegarde automatique toutes les <strong>6 heures</strong>. Les 20 dernières sont conservées. Copiez régulièrement le dossier sauvegardes sur un support externe.
                        </div>
                    </div>
                </div>

                <div class="panel" style="border-color:rgba(232,184,75,.3)">
                    <div class="panel-header" style="border-color:rgba(232,184,75,.2)">
                        <h2><i class="bi bi-router me-2" style="color:#f3d486"></i>Configuration réseau</h2>
                        <p>URL d'écoute du serveur Nouba — local ou multi-postes (LAN)</p>
                    </div>
                    <div class="panel-body">
                        @{
                            var currentUri = Uri.TryCreate(settings.ServerUrl, UriKind.Absolute, out var uri) ? uri : null;
                            var currentHost = currentUri?.Host ?? "127.0.0.1";
                            var currentPort = currentUri?.Port ?? 5000;
                            bool isLocal = currentHost == "127.0.0.1" || currentHost == "localhost";
                            bool isLanAny = currentHost == "0.0.0.0";
                            bool isFixedIp = !isLocal && !isLanAny;
                            string currentMode = isLocal ? "local" : (isLanAny ? "lan-any" : "lan-fixed");
                            string modeColor = isLocal ? "#fbbf24" : (isLanAny ? "#34d399" : "#f3d486");
                            string modeLabel = isLocal ? "LOCAL UNIQUEMENT" : (isLanAny ? "LAN MULTI-POSTES" : "IP FIXE");

                            // Récupérer la liste des IPs locales détectées (si exposées par le contrôleur)
                            var localIps = ViewBag.LocalIpAddresses as List<string> ?? new List<string>();
                        }

                        <!-- Bandeau d'état actuel -->
                        <div style="background:linear-gradient(135deg,rgba(@(isLocal?"251,191,36":(isLanAny?"52,211,153":"167,139,250")),.1),rgba(@(isLocal?"251,191,36":(isLanAny?"52,211,153":"167,139,250")),.04));border:1px solid rgba(@(isLocal?"251,191,36":(isLanAny?"52,211,153":"167,139,250")),.3);border-radius:14px;padding:16px;margin-bottom:18px">
                            <div style="display:flex;align-items:center;gap:14px">
                                <div style="width:44px;height:44px;border-radius:12px;background:rgba(@(isLocal?"251,191,36":(isLanAny?"52,211,153":"167,139,250")),.18);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                    <i class="bi @(isLocal?"bi-pc-display":(isLanAny?"bi-broadcast":"bi-globe2"))" style="font-size:1.4rem;color:@modeColor"></i>
                                </div>
                                <div style="flex:1">
                                    <div style="font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);font-weight:700;margin-bottom:2px">Mode actif</div>
                                    <div style="font-size:.95rem;font-weight:800;color:#fff">@modeLabel</div>
                                    <div style="font-family:monospace;font-size:.78rem;color:#cbd5e1;margin-top:2px">@settings.ServerUrl</div>
                                </div>
                                <div style="display:flex;align-items:center;gap:6px;font-size:.75rem;color:#34d399;font-weight:700">
                                    <span style="width:8px;height:8px;border-radius:50%;background:#22c55e;box-shadow:0 0 10px #22c55e;animation:pulse 2s infinite"></span>
                                    Serveur actif
                                </div>
                            </div>
                        </div>

                        <form asp-action="UpdateNetworkConfig" method="post" class="vstack gap-3">
                            @Html.AntiForgeryToken()

