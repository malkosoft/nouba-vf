// ── Printer ping ──
function pingPrinter(){
    var dot = document.getElementById('printerStatusDot');
    var txt = document.getElementById('printerStatusText');
    if(!dot || !txt) return;
    dot.style.background='#fbbf24'; dot.style.boxShadow='0 0 8px #fbbf24';
    txt.textContent='Test en cours…';
    fetch('/Printer/Ping', {cache:'no-store'})
      .then(r=>r.json())
      .then(d=>{
        if(d.ok){
            dot.style.background='#22c55e'; dot.style.boxShadow='0 0 10px #22c55e';
            txt.innerHTML='<strong style="color:#86efac">Imprimante en ligne</strong> · '+d.ip+':'+d.port;
        }else{
            dot.style.background='#ef4444'; dot.style.boxShadow='0 0 10px #ef4444';
            var reason = d.reason==='disabled' ? 'Imprimante désactivée dans les paramètres'
                       : d.reason==='no-ip' ? 'Aucune adresse IP configurée'
                       : d.reason==='timeout' ? 'Pas de réponse — vérifiez l\'IP, le câble réseau et que l\'imprimante est allumée'
                       : ('Erreur : '+(d.reason||'inconnue'));
            txt.innerHTML='<strong style="color:#fca5a5">Hors ligne</strong> · '+(d.ip||'?')+':'+(d.port||'?')+' · '+reason;
        }
      })
      .catch(e=>{
        dot.style.background='#ef4444';
        txt.innerHTML='<strong style="color:#fca5a5">Erreur</strong> · '+e.message;
      });
}

