                <div class="kpi-value" id="kpi-total">@totalToday</div>
                <div class="kpi-label">Total aujourd'hui</div>
                <div class="kpi-trend" style="color:@diffColor;font-weight:700">@diffArrow @(Math.Abs(diffTotal)) tickets vs hier (@yTotal)</div>
            </div>
            <div class="kpi-card" style="--kpi-color:#f59e0b">
                <div class="kpi-icon">⏳</div>
                <div class="kpi-value" id="kpi-waiting">@waitingNow</div>
                <div class="kpi-label">En attente</div>
            </div>
            <div class="kpi-card" style="--kpi-color:#3b82f6">
                <div class="kpi-icon">📣</div>
                <div class="kpi-value" id="kpi-called">@calledNow</div>
                <div class="kpi-label">Appelés</div>
            </div>
            <div class="kpi-card" style="--kpi-color:#22c55e">
                <div class="kpi-icon">✅</div>
                <div class="kpi-value" id="kpi-served">@servedToday</div>
                <div class="kpi-label">Servis</div>
                <div class="kpi-trend">vs hier : @yServed</div>
            </div>
            <div class="kpi-card" style="--kpi-color:#ef4444">
                <div class="kpi-icon">❌</div>
                <div class="kpi-value" id="kpi-absent">@absentToday</div>
                <div class="kpi-label">Absents</div>
                <div class="kpi-trend" style="color:@(absRate > 15 ? "#ef4444" : "#94a3b8")">Taux d'absence : @absRate.ToString("0.0")%</div>
            </div>
            <div class="kpi-card" style="--kpi-color:#f3d486">
                <div class="kpi-icon">⏱️</div>
                <div class="kpi-value" id="kpi-avgwait">@avgWait<span style="font-size:1rem">min</span></div>
                <div class="kpi-label">Attente moy.</div>
            </div>
