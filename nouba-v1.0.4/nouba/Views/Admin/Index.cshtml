                                @foreach (var (em, tt) in new[]{ ("🛒","Commerce / Achat"),("🏪","Boutique / Magasin"),("🛍️","Shopping / Sacs"),("📦","Livraison / Colis"),("📫","Courrier / Boîte"),("🎁","Cadeau / Bon"),("🏷️","Étiquette / Tarif"),("🛎️","Service / Accueil"),("💝","Fidélité / Avantage"),("📮","Bureau postal"),("🧺","Collecte / Panier"),("🪣","Stockage") }){ <button type="button" class="emoji-opt" data-emoji="@em" title="@tt">@em</button> }
                                <span class="emoji-cat">🍽️ Restauration &amp; Accueil</span>
                                @foreach (var (em, tt) in new[]{ ("🍽️","Restaurant / Repas"),("☕","Café / Pause"),("🥗","Nutrition / Alimentation"),("🍕","Pizza / Snacking"),("🥙","Restauration rapide"),("🍹","Boissons / Bar"),("🍰","Pâtisserie / Dessert"),("🥐","Boulangerie / Petit-déj"),("🫖","Thé / Tisane"),("🍱","Traiteur / Plateau repas"),("🍔","Burger"),("🧆","Cuisine orientale") }){ <button type="button" class="emoji-opt" data-emoji="@em" title="@tt">@em</button> }
                                <span class="emoji-cat">🔧 Technique &amp; Maintenance</span>
                                @foreach (var (em, tt) in new[]{ ("🔧","Réparation / Outillage"),("🛠️","Maintenance / Travaux"),("⚙️","Paramètres / Mécanique"),("🔩","Visserie / Assemblage"),("🔌","Électricité / Branchement"),("💡","Éclairage / Innovation"),("🔋","Alimentation / Batterie"),("📱","Mobile / Téléphonie"),("🖨️","Impression / Reprographie"),("📡","Antenne / Réseau"),("🔦","Éclairage / Inspection"),("🪛","Tournevis / Fine mécanique"),("🧰","Boîte à outils") }){ <button type="button" class="emoji-opt" data-emoji="@em" title="@tt">@em</button> }
                                <span class="emoji-cat">☎️ Communication &amp; Télécom</span>
                                @foreach (var (em, tt) in new[]{ ("☎️","Téléphone fixe"),("📞","Standard / Appel"),("📟","Bipeur / Radio"),("📠","Fax / Télécopie"),("🌐","Internet / International"),("📶","Réseau / Signal"),("🔔","Notification / Alerte"),("📣","Annonce / Diffusion"),("📢","Haut-parleur / Message"),("✉️","Courrier / Email"),("📨","Message entrant"),("💬","Chat / Messagerie") }){ <button type="button" class="emoji-opt" data-emoji="@em" title="@tt">@em</button> }
                                <span class="emoji-cat">⭐ Divers &amp; Spéciaux</span>
                                @foreach (var (em, tt) in new[]{ ("⭐","Premium / VIP"),("🌟","Excellence / Étoilé"),("💫","Mise en avant"),("✅","Validation / Clôture"),("⚠️","Alerte / Attention"),("🎯","Objectif / Ciblé"),("🏅","Récompense / Médaille"),("🥇","Premier / Champion"),("🌿","Environnement / Éco"),("🌈","Diversité / Inclusion"),("🔰","Nouveau / Débutant"),("🕐","Horaires / Rendez-vous"),("📍","Localisation / Guichet"),("🎫","Ticket / Bon"),("🆘","Urgence / SOS") }){ <button type="button" class="emoji-opt" data-emoji="@em" title="@tt">@em</button> }
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary btn-w"><i class="bi bi-plus-lg"></i> Ajouter le service</button>
                    </form>
                </div>
            </div>

            <div class="panel">
                <div class="panel-header"><h2><i class="bi bi-layers me-2" style="color:var(--accent)"></i>Services configurés</h2><p>@Model.Count service(s)</p></div>
                <div class="panel-body" style="max-height:500px;overflow-y:auto;display:flex;flex-direction:column;gap:10px;">
                    @foreach (var svc in Model)
                    {
                        <div class="service-card">
                            <div class="service-dot" style="background:@svc.ButtonColor;color:@svc.TextColor;">@svc.Code</div>
                            <div class="service-info">
                                <div class="service-name">@svc.Name</div>
                                <div class="service-code">Code: @svc.Code · Ordre: @svc.DisplayOrder · @(svc.IsActive?"Actif":"Inactif")</div>
                            </div>
                            <div class="service-actions" style="display:flex;gap:8px;flex-wrap:wrap;">
                                <button type="button" class="btn btn-ghost btn-sm js-edit-service"
                                        data-id="@svc.Id"
                                        data-name="@svc.Name"
                                        data-code="@svc.Code"
                                        data-order="@svc.DisplayOrder"
                                        data-btn-color="@svc.ButtonColor"
                                        data-text-color="@svc.TextColor"
                                        data-logo="@(svc.LogoUrl ?? "")"
                                        data-name-ar="@(svc.NameAr ?? "")"
                                        data-name-tz="@(svc.NameTz ?? "")"
                                        data-name-en="@(svc.NameEn ?? "")"
                                        title="Modifier ce service">
                                    <i class="bi bi-pencil"></i> Modifier
                                </button>
                                <form asp-action="DeleteService" method="post"
                                      data-confirm="Supprimer définitivement le service « @(svc.Name.Replace("\\","\\\\").Replace("\"","")) » ?&#10;&#10;Les guichets et tickets associés seront aussi supprimés. Les agents seront réassignés ou désactivés."
                                      data-confirm-danger="1" data-confirm-title="Supprimer le service"
                                      style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@svc.Id"/>
                                    <button type="submit" class="btn btn-danger btn-sm" title="Supprimer ce service">
                                        <i class="bi bi-trash"></i> Supprimer
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ TAB: GUICHETS ═══ -->
    <div class="tab-pane @(tab=="counters"?"active":"")" id="tab-counters">
        <div class="grid-2">
            <div class="panel">
                <div class="panel-header"><h2><i class="bi bi-plus-circle me-2" style="color:var(--accent)"></i>Nouveau guichet</h2></div>
                <div class="panel-body">
                    <form asp-action="AddCounter" method="post" class="vstack gap-3">
                        @Html.AntiForgeryToken()
                        <div><label>Nom du guichet</label><input class="form-control" name="name" placeholder="Guichet 4" required/></div>
                        <div>
                            <label>Service associé</label>
                            <select class="form-select" name="serviceTypeId">
                                @foreach (var s in Model) { <option value="@s.Id">@s.Name</option> }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary btn-w"><i class="bi bi-plus-lg"></i> Ajouter</button>
                    </form>
                </div>
            </div>

            <div class="panel">
                <div class="panel-header"><h2><i class="bi bi-person-workspace me-2" style="color:var(--accent)"></i>Guichets</h2><p>@counters.Count guichet(s)</p></div>
                <div class="panel-body" style="padding:0;">
                    <table class="data-table">
                        <thead><tr><th>Guichet</th><th>Service</th><th>Statut</th><th>Actions</th></tr></thead>
                        <tbody>
                        @foreach (var c in counters)
                        {
                            <tr>
                                <td><span style="font-weight:700;color:#fff;">@c.Name</span></td>
                                <td><span class="badge badge-blue">@(c.ServiceType?.Name ?? "—")</span></td>
                                <td><span class="badge @(c.IsActive?"badge-green":"badge-gray")">@(c.IsActive?"Actif":"Inactif")</span></td>
                                <td>
                                    <div style="display:flex;flex-direction:column;gap:8px;align-items:stretch;min-width:280px;">
                                        <form asp-action="UpdateCounter" method="post" style="display:grid;grid-template-columns:1fr 1fr auto;gap:6px;align-items:center;margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@c.Id"/>
                                            <input class="form-control form-control-sm" name="name" value="@c.Name" placeholder="Nom" style="padding:6px 10px;min-width:0;"/>
                                            <select class="form-select form-select-sm" name="serviceTypeId" style="padding:6px 10px;min-width:0;">
                                                @foreach (var s in Model)
                                                { <option value="@s.Id" selected="@(s.Id==c.ServiceTypeId?"selected":null)">@s.Name</option> }
                                            </select>
                                            <button type="submit" class="btn btn-success btn-sm" title="Enregistrer les modifications" style="white-space:nowrap;">
                                                <i class="bi bi-check-lg"></i> Enregistrer
                                            </button>
                                        </form>
                                        <form asp-action="DeleteCounter" method="post"
                                              data-confirm="Supprimer définitivement le guichet « @(c.Name.Replace("\\","\\\\").Replace("\"","")) » ?&#10;&#10;Les tickets liés seront supprimés. Les agents seront réassignés à un autre guichet du même service ou désactivés."
                                              data-confirm-danger="1" data-confirm-title="Supprimer le guichet"
                                              style="margin:0;display:flex;justify-content:flex-end;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@c.Id"/>
                                            <button type="submit" class="btn btn-danger btn-sm" title="Supprimer ce guichet" style="white-space:nowrap;">
                                                <i class="bi bi-trash"></i> Supprimer
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ TAB: AGENTS ═══ -->
    <div class="tab-pane @(tab=="agents"?"active":"")" id="tab-agents">
        <div class="grid-2">
            <div class="panel">
                <div class="panel-header"><h2><i class="bi bi-person-plus me-2" style="color:var(--accent)"></i>Nouvel agent</h2></div>
                <div class="panel-body">
                    <form asp-action="AddAgent" method="post" class="vstack gap-3">
                        @Html.AntiForgeryToken()
                        <div><label>Nom complet</label><input class="form-control" name="fullName" placeholder="Prénom Nom" required/></div>
                        <div class="grid-2" style="gap:12px;">
                            <div><label>Identifiant</label><input class="form-control" name="login" placeholder="agent4" required/></div>
                            <div><label>Mot de passe</label><input class="form-control" name="password" type="password" required/></div>
                        </div>
                        <div>
                            <label>Guichet assigné</label>
                            <select class="form-select" name="counterId">
                                @foreach (var c in counters.Where(x => x.IsActive)) { <option value="@c.Id">@c.Name (@(c.ServiceType?.Name??""))</option> }
                            </select>
                        </div>
                        <div style="color:var(--muted);font-size:.85rem;padding:10px 12px;border:1px solid var(--border);border-radius:14px;background:rgba(255,255,255,.04);">Le service de l’agent est automatiquement celui du guichet assigné.</div>
                        <button type="submit" class="btn btn-primary btn-w"><i class="bi bi-person-plus"></i> Créer l'agent</button>
                    </form>
                </div>
            </div>

            <div class="panel">
                <div class="panel-header"><h2><i class="bi bi-people me-2" style="color:var(--accent)"></i>Agents</h2><p>@agents.Count agent(s)</p></div>
                <div class="panel-body" style="max-height:500px;overflow-y:auto;">
                    @foreach (var agent in agents)
                    {
                        <div class="agent-row">
                            <div class="agent-avatar">@(agent.FullName.Length>0?agent.FullName[0].ToString().ToUpper():"A")</div>
                            <div class="agent-info" style="flex:1;min-width:0;">
                                <div class="agent-name">@agent.FullName <span class="badge @(agent.IsActive?"badge-green":"badge-red")" style="margin-left:6px;">@(agent.IsActive?"Actif":"Inactif")</span></div>
                                <div class="agent-detail">@agent.Login · @(agent.Counter?.Name??"—") · @(agent.ServiceType?.Name??"—")</div>
                                <form asp-action="AssignAgentCounter" method="post" style="display:flex;gap:6px;margin-top:8px;align-items:center;flex-wrap:wrap;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="agentId" value="@agent.Id"/>
                                    <label style="font-size:.78rem;color:var(--muted);white-space:nowrap;">Assigner à&nbsp;:</label>
                                    <select class="form-select form-select-sm" name="counterId" style="padding:4px 8px;font-size:.85rem;flex:1;min-width:160px;">
                                        @foreach (var ct in counters.Where(x => x.IsActive))
                                        {
                                            <option value="@ct.Id" selected="@(ct.Id==agent.CounterId?"selected":null)">@ct.Name (@(ct.ServiceType?.Name??""))</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-success btn-sm" title="Réassigner cet agent">
                                        <i class="bi bi-arrow-left-right"></i> Assigner
                                    </button>
                                </form>
                            </div>
                            <div style="display:flex;gap:6px;flex-wrap:wrap;align-self:flex-start;">
                                <button type="button" class="btn btn-ghost btn-sm js-edit-agent"
                                        data-id="@agent.Id"
                                        data-name="@agent.FullName"
                                        data-login="@agent.Login"
                                        data-counter="@agent.CounterId"
                                        data-active="@agent.IsActive.ToString().ToLower()"
                                        title="Modifier cet agent">
                                    <i class="bi bi-pencil"></i> Modifier
                                </button>
                                <form asp-action="DeleteAgent" method="post"
                                      data-confirm="Supprimer définitivement l'agent « @(agent.FullName.Replace("\\","\\\\").Replace("\"","")) » ?&#10;&#10;L'historique des appels qu'il a effectués sera conservé."
                                      data-confirm-danger="1" data-confirm-title="Supprimer l'agent"
                                      style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@agent.Id"/>
                                    <button type="submit" class="btn btn-danger btn-sm" title="Supprimer cet agent">
                                        <i class="bi bi-trash"></i> Supprimer
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ TAB: AFFICHAGE & VOIX ═══ -->
    <div class="tab-pane @(tab=="display"?"active":"")" id="tab-display">
        <form asp-action="UpdateSettings" method="post" enctype="multipart/form-data" data-display-settings-form>
            @Html.AntiForgeryToken()

            <div class="settings-savebar">
                <div>
                    <div class="settings-savebar-title"><i class="bi bi-display me-2" style="color:var(--accent2)"></i>Écran d'affichage</div>
                    <div class="settings-savebar-sub">Réglages de l'écran TV, des voix, des médias et du suivi mobile.</div>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-floppy"></i> Enregistrer les modifications
                </button>
            </div>

            <div class="settings-tabs" data-settings-tabs="display">
                <button type="button" class="settings-tab active" data-settings-target="appearance"><i class="bi bi-palette"></i> Apparence</button>
                <button type="button" class="settings-tab" data-settings-target="voice"><i class="bi bi-speaker"></i> Voix & son TV</button>
                <button type="button" class="settings-tab" data-settings-target="media"><i class="bi bi-image"></i> Médias</button>
                <button type="button" class="settings-tab" data-settings-target="banner"><i class="bi bi-type"></i> Langue & bandeau</button>
            </div>

            <div class="settings-section active" data-settings-section="appearance">
                <div class="settings-section-grid">
                    <div class="panel">
                        <div class="panel-header"><h2><i class="bi bi-palette me-2" style="color:var(--accent)"></i>Thème & Apparence</h2></div>
                        <div class="panel-body vstack gap-3">
                            <div>
                                <label>Nom du site (en haut à gauche)</label>
                                <input class="form-control" name="SiteName" value="@settings.SiteName"/>
                                <div class="settings-help" style="margin-top:6px">
                                    <i class="bi bi-info-circle"></i>
                                    Affiché à côté du logo en haut à gauche de l'écran TV et de la borne.
                                </div>
                            </div>

                            <div style="background:rgba(232,184,75,.08);border:1px solid rgba(232,184,75,.25);border-radius:14px;padding:14px;margin:6px 0">
                                <label style="display:flex;align-items:center;gap:8px;font-weight:800;color:#fff;font-size:.95rem">
                                    <i class="bi bi-card-heading" style="color:var(--accent2)"></i>
                                    Titre principal de l'écran TV
                                </label>
                                <div class="settings-help" style="margin:8px 0 12px 0">
                                    Le grand texte qui apparaît en haut au centre de l'écran TV.
                                    Ce texte se met à jour automatiquement sur l'écran TV après enregistrement.
                                    Si vide, le « Nom du site » ci-dessus sera utilisé.
                                </div>
                                @foreach (var (lang,ico,labelL) in new[]{
                                    ("Fr","🇫🇷","Français"),
                                    ("Ar","🇩🇿","العربية"),
                                    ("Tz","ⵣ","Tamazight"),
                                    ("En","🇬🇧","English")})
                                {
                                    var displayTitleProp = typeof(Nouba.Models.UiSettings).GetProperty("DisplayTitle"+lang)?.GetValue(settings)?.ToString() ?? "";
                                    var headerProp = typeof(Nouba.Models.UiSettings).GetProperty("HeaderText"+lang)?.GetValue(settings)?.ToString() ?? "";
                                    var stockTitle = (lang == "Fr" && (displayTitleProp == "Numéro appelé" || displayTitleProp == "NumÃ©ro appelÃ©"))
                                        || (lang == "En" && displayTitleProp == "Now serving")
                                        || (lang == "Tz" && (displayTitleProp == "Uṭṭun yettwasiwlen" || displayTitleProp == "Uá¹­á¹­un yettwasiwlen"))
                                        || (lang == "Ar" && !string.IsNullOrWhiteSpace(displayTitleProp) && displayTitleProp.Contains("Ø§Ù„Ø±Ù‚Ù…"));
                                    var effectiveDisplayTitle = stockTitle && !string.IsNullOrWhiteSpace(headerProp) ? headerProp : displayTitleProp;
                                    <div style="margin-bottom:8px">
                                        <label style="font-size:.78rem;color:var(--muted);font-weight:600">@ico @labelL</label>
                                        <input class="form-control"
                                               name="DisplayHeaderTitle@lang"
                                               value="@effectiveDisplayTitle"
                                               data-display-header-title="@lang"
                                               data-last-saved-title="@effectiveDisplayTitle"
                                               placeholder="Ex : Agence Air Algérie - Tizi-Ouzou"/>
                                        <input type="hidden" name="DisplayTitle@lang" value="@effectiveDisplayTitle" data-display-title-shadow="@lang"/>
                                        <input type="hidden" name="HeaderText@lang" value="@effectiveDisplayTitle" data-header-title-shadow="@lang"/>
                                        <small data-display-title-status="@lang" style="display:block;margin-top:4px;color:var(--muted);font-size:.72rem;min-height:16px"></small>
                                    </div>
                                }
                            </div>

                            <div>
                                <label>Modèle d'interface</label>
                                <!-- Galerie de cartes preset premium.
                                     L'input "ThemePreset" reste un champ caché (compatibilité serveur),
                                     les cartes mettent à jour sa valeur au clic via applyTheme().
                                     Une carte "active" est celle dont la valeur correspond à ThemePreset. -->
                                <input type="hidden" name="ThemePreset" id="ThemePresetInput" value="@settings.ThemePreset"/>
                                <div class="preset-grid" id="presetGrid">
                                    @{
                                        var presets = new[]{
                                            ("clinique",       "🏥", "Clinique",       "Clair, rassurant, médical",        "#0ea5e9", "#082f49", "#0c4a6e", "#0ea5e9"),
                                            ("administration", "🏛️", "Administration", "Officiel, lisible, neutre",        "#1d4ed8", "#102a43", "#0b1f33", "#1d4ed8"),
                                            ("apc",            "🏢", "APC",            "Commune, documents, citoyens",     "#047857", "#064e3b", "#022c22", "#047857"),
                                            ("telecom",        "📶", "Télécom",        "Agence opérateur, moderne",        "#0f766e", "#0b1120", "#134e4a", "#dc2626"),
                                            ("banque",         "🏦", "Banque",         "Premium, sérieux, sécurisé",       "#15803d", "#052e16", "#0a2512", "#15803d"),
                                            ("mairie",         "🏛", "Mairie",         "Accessible, public, multilingue",  "#2563eb", "#0f172a", "#111827", "#1e40af"),
                                            ("entreprise",     "🏢", "Entreprise",     "Moderne, corporate, flexible",     "#e8b84b", "#111827", "#0f172a", "#4f46e5"),
                                            ("aeroport",       "✈️", "Aéroport",       "Trafic, lisibilité maximale",      "#0891b2", "#083344", "#0e7490", "#06b6d4"),
                                            ("poste",          "📮", "Poste",          "Service public, jaune signal",      "#eab308", "#1c1917", "#292524", "#ca8a04"),
                                            ("tribunal",       "⚖️", "Tribunal",       "Sobre, autoritaire, formel",       "#7c2d12", "#1c1917", "#292524", "#9a3412"),
                                        };
                                    }
                                    @foreach (var (key, icon, name, desc, accent, card, hist, footer) in presets)
                                    {
                                        <button type="button"
                                                class="preset-card @(settings.ThemePreset==key?"active":"")"
                                                data-preset="@key"
                                                onclick="applyTheme('@key')">
                                            <span class="pc-active-tag"><i class="bi bi-check-lg"></i> Actif</span>
                                            <span class="pc-icon" style="background:linear-gradient(135deg,@accent,@footer)">@icon</span>
                                            <div>
                                                <div class="pc-name">@name</div>
                                                <div class="pc-desc">@desc</div>
                                            </div>
                                            <div class="pc-swatches">
                                                <span class="pc-swatch" style="background:@accent"></span>
                                                <span class="pc-swatch" style="background:@card"></span>
                                                <span class="pc-swatch" style="background:@hist"></span>
                                                <span class="pc-swatch" style="background:@footer"></span>
                                            </div>
                                        </button>
                                    }
                                </div>
                                <div class="preset-actions">
                                    <button type="button" class="btn btn-ghost" onclick="restoreDefaultTheme()">
                                        <i class="bi bi-arrow-counterclockwise"></i> Restaurer le thème par défaut
                                    </button>
                                </div>
                                <div class="settings-help" style="margin-top:12px">
                                    <i class="bi bi-info-circle"></i>
                                    Adapte <b>couleurs</b>, <b>audio</b> et <b>textes</b> selon le secteur. Pensez à <b>Enregistrer</b>.
                                </div>
                            </div>
                            <div>
                                <label>Mise en page</label>
                                <select class="form-select" name="DisplayLayout">
                                    <option value="standard"   selected="@(settings.DisplayLayout=="standard"  ?"selected":null)">Standard — ticket + historique + média</option>
                                    <option value="large"      selected="@(settings.DisplayLayout=="large"     ?"selected":null)">Plein écran — ticket seul, sans panneau droit</option>
                                    <option value="tv-wall"    selected="@(settings.DisplayLayout=="tv-wall"   ?"selected":null)">TV Wall — ticket géant + historique en bandeau bas</option>
                                    <option value="video-hero" selected="@(settings.DisplayLayout=="video-hero"?"selected":null)">Vidéo dominante — média en haut, ticket en bas</option>
                                    <option value="minimal"    selected="@(settings.DisplayLayout=="minimal"   ?"selected":null)">Minimal — un seul ticket, écran épuré</option>
                                </select>
                            </div>
                            <div>
                                <label>Lignes d'historique</label>
                                <input class="form-control" type="number" name="DisplayHistoryRows" value="@settings.DisplayHistoryRows" min="1" max="20"/>
                            </div>
                        </div>
                    </div>

                    <div class="panel">
                        <div class="panel-header"><h2><i class="bi bi-palette2 me-2" style="color:var(--accent)"></i>Couleurs</h2></div>
                        <div class="panel-body vstack gap-3">
                            @{
                                var colorFields = new[]{
                                    ("DisplayAccentColor",   settings.DisplayAccentColor,  "Couleur accent"),
                                    ("DisplayCardColor",     settings.DisplayCardColor,    "Fond carte ticket"),
                                    ("DisplayHistoryColor",  settings.DisplayHistoryColor, "Fond historique"),
                                    ("DisplayFooterColor",   settings.DisplayFooterColor,  "Fond bandeau bas"),
                                    ("DisplayTextColor",     settings.DisplayTextColor,    "Texte ticket"),
                                    ("DisplayTicketBgColor", settings.DisplayTicketBgColor,"Fond numéro actif"),
                                };
                            }
                            @foreach (var (fname, fval, flabel) in colorFields)
                            {
                                <div>
                                    <label>@flabel</label>
                                    <input type="color" class="color-swatch color-swatch-wide" value="@fval" id="col_@fname" name="@fname"/>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="settings-section" data-settings-section="voice">
                <div class="settings-section-grid">
                    <div class="panel">
                        <div class="panel-header">
                            <h2><i class="bi bi-speaker me-2" style="color:var(--accent)"></i>Voix & son TV</h2>
                            <span class="status-pill" id="ttsAdminPill">Vérification en cours…</span>
                        </div>
                        <div class="panel-body vstack gap-4">
                            <div class="settings-help">
                                Voix locale intégrée. Si indisponible sur un poste, Nouba bascule sur la voix du navigateur.
                            </div>
                            <div class="toggle">
                                <input type="hidden" name="EnableVoiceAnnouncements" value="false"/>
                                <input type="checkbox" id="ttsOn" name="EnableVoiceAnnouncements" value="true" @(settings.EnableVoiceAnnouncements?"checked":"")/>
                                <label for="ttsOn">Activer les annonces vocales</label>
                            </div>
                            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;">
                                <button type="button" class="btn btn-ghost" onclick="testVoice('fr')"><i class="bi bi-play-circle"></i> Tester FR</button>
                                <button type="button" class="btn btn-ghost" onclick="testVoice('en')"><i class="bi bi-play-circle"></i> Tester EN</button>
                                <button type="button" class="btn btn-ghost" onclick="testVoice('ar')"><i class="bi bi-play-circle"></i> Tester AR</button>
                            </div>
                            <div id="ttsStatusCards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;">
                                <div class="mini-status-card"><strong>Français</strong><span>Vérification…</span></div>
                                <div class="mini-status-card"><strong>English</strong><span>Vérification…</span></div>
                                <div class="mini-status-card"><strong>العربية</strong><span>Vérification…</span></div>
                            </div>
                        </div>
                    </div>

                    <div class="panel">
                        <div class="panel-header"><h2><i class="bi bi-sliders me-2" style="color:var(--accent)"></i>Réglages voix</h2></div>
                        <div class="panel-body vstack gap-4">

                            <!-- Genre de voix : cartes premium avec explication par langue. -->
                            <div>
                                <label style="display:flex;align-items:center;justify-content:space-between;">
                                    <span><i class="bi bi-mic-fill me-1" style="color:var(--accent2)"></i>Genre de voix</span>
                                    <span id="voiceGenderHint" style="font-size:.68rem;color:var(--muted);text-transform:none;letter-spacing:0;font-weight:500;">Français, anglais et arabe (le tamazight a une voix unique)</span>
                                </label>
                                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                                    @foreach(var (v,l,ic,desc) in new[]{
                                        ("female","Féminine","♀","Voix douce et accueillante"),
                                        ("male","Masculine","♂","Voix grave et professionnelle")
                                    })
                                    {
                                        <label data-voice-gender-card="@v"
                                               style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;padding:18px 12px;border-radius:14px;border:2px solid;border-color:@(settings.VoiceGender==v?"var(--accent)":"var(--border)");cursor:pointer;background:@(settings.VoiceGender==v?"linear-gradient(135deg,rgba(232,184,75,.18),rgba(129,140,248,.08))":"var(--surface2)");transition:all .2s;text-align:center;">
                                            <input type="radio" name="VoiceGender" value="@v" @(settings.VoiceGender==v?"checked":"") data-voice-gender-input style="display:none;"/>
                                            <span style="font-size:2rem;line-height:1;color:@(settings.VoiceGender==v?"var(--accent2)":"var(--muted)");">@ic</span>
                                            <span style="font-size:.92rem;font-weight:800;color:@(settings.VoiceGender==v?"#fff":"var(--text)")">@l</span>
                                            <span style="font-size:.7rem;color:var(--muted);font-weight:500;line-height:1.3;">@desc</span>
                                        </label>
                                    }
                                </div>
                                <div id="voiceGenderSaveStatus" style="display:block;margin-top:8px;color:var(--muted);font-size:.74rem;min-height:18px;display:flex;align-items:center;gap:6px;"></div>
                                <div style="margin-top:10px;padding:10px 12px;background:rgba(232,184,75,.06);border:1px solid rgba(232,184,75,.18);border-radius:10px;font-size:.72rem;color:var(--muted);line-height:1.5;">
                                    <i class="bi bi-info-circle me-1" style="color:var(--accent2)"></i>
                                    <strong style="color:var(--text);">Note :</strong> Le choix Masculin / Féminin s'applique au <b>français</b>, à l'<b>anglais</b> et à l'<b>arabe</b>. Le tamazight dispose d'une voix unique. Les voix masculines nécessitent le modèle Piper correspondant : l'onglet <b>Diagnostic</b> indique précisément lesquels sont installés et lesquels ajouter.
                                </div>
                            </div>

                            <div>
                                <label>Répétitions : <strong id="repeatVal">@settings.VoiceRepeatCount</strong>×</label>
                                <input type="range" name="VoiceRepeatCount" min="1" max="5" value="@settings.VoiceRepeatCount"
                                       oninput="document.getElementById('repeatVal').textContent=this.value"/>
                            </div>
                            <div>
                                <label>Vitesse de parole : <strong id="rateVal">@settings.VoiceRate.ToString("0.00")</strong></label>
                                <input type="range" name="VoiceRate" min="0.5" max="2" step="0.05"
                                       value="@settings.VoiceRate.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                       oninput="document.getElementById('rateVal').textContent=parseFloat(this.value).toFixed(2)"/>
                            </div>
                            <div>
                                <label>Hauteur (pitch) : <strong id="pitchVal">@settings.VoicePitch.ToString("0.0")</strong></label>
                                <input type="range" name="VoicePitch" min="0.5" max="2" step="0.1"
                                       value="@settings.VoicePitch.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)"
                                       oninput="document.getElementById('pitchVal').textContent=parseFloat(this.value).toFixed(1)"/>
                            </div>
                            <div>
                                <label>Volume : <strong id="volVal">@settings.VoiceVolume.ToString("0.0")</strong></label>
                                <input type="range" name="VoiceVolume" min="0.1" max="1" step="0.1"
                                       value="@settings.VoiceVolume.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)"
                                       oninput="document.getElementById('volVal').textContent=parseFloat(this.value).toFixed(1)"/>
                            </div>
                        </div>
                    </div>

                    <div class="panel">
                        <div class="panel-header"><h2><i class="bi bi-toggles me-2" style="color:var(--accent)"></i>Options affichage utiles</h2></div>
                        <div class="panel-body vstack gap-3">
                            @{
                                var toggles = new[]{
                                    ("ShowClockOnDisplay",    settings.ShowClockOnDisplay,   "Horloge sur l'affichage"),
                                    ("EnableAnimations",      settings.EnableAnimations,     "Animations & effet wow activés"),
                                    ("EnableFullScreenButton",settings.EnableFullScreenButton,"Bouton plein écran"),
                                    ("ShowServiceNameOnDisplay",settings.ShowServiceNameOnDisplay,"Nom du service visible"),
                                    ("ShowCounterNameOnDisplay",settings.ShowCounterNameOnDisplay,"Nom du guichet visible"),
                                    ("ShowCallTimeOnDisplay", settings.ShowCallTimeOnDisplay, "Heure d'appel visible"),
                                    ("ShowWaitingCountOnAgent",settings.ShowWaitingCountOnAgent,"Compteur attente (agent)"),
                                };
                            }
                            @foreach (var (tname, tval, tlabel) in toggles)
                            {
                                <div class="toggle">
                                    <input type="hidden" name="@tname" value="false"/>
                                    <input type="checkbox" id="tog_@tname" name="@tname" value="true" @(tval?"checked":"")/>
                                    <label for="tog_@tname">@tlabel</label>
                                </div>
                            }
                            <hr class="divider"/>
                            <div>
                                <label>Durée effet wow <span style="color:var(--muted);font-weight:400">(ms — 0 = désactivé)</span></label>
                                <input class="form-control" type="number" name="WowDurationMs" value="@settings.WowDurationMs" min="0" max="8000" step="100"/>
                            </div>
                            <div>
                                <label>Son avant annonce vocale</label>
                                <select class="form-select" name="WowSoundChoice">
                                    @foreach (var (sv,sl) in new[]{("chime","🔔 Bi-bong doux (défaut)"),("ding","🎵 Ding — note unique"),("gong","🪘 Gong — résonance longue"),("none","🔇 Aucun son")})
                                    {
                                        if (sv == settings.WowSoundChoice)
                                        {
                                            <option value="@sv" selected="selected">@sl</option>
                                        }
                                        else
                                        {
                                            <option value="@sv">@sl</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="settings-section" data-settings-section="media">
                <div class="settings-section-grid single">
                    <div class="panel">
                        <div class="panel-header"><h2><i class="bi bi-image me-2" style="color:var(--accent)"></i>Médias & Logos</h2></div>
                        <div class="panel-body vstack gap-3">
                            <div>
                                <label>Logo principal (URL ou chemin local)</label>
                                <input class="form-control" name="HeaderImageUrl" value="@settings.HeaderImageUrl" placeholder="/uploads/logo.png ou https://..."/>
                                <input class="form-control mt-2" type="file" name="headerImageFile" accept="image/*"/>
                            </div>
                            <div>
                                <label>Logo sur affichage (URL ou chemin local)</label>
                                <input class="form-control" name="DisplayLogoUrl" value="@settings.DisplayLogoUrl" placeholder="/uploads/logo.png ou https://..."/>
                                <input class="form-control mt-2" type="file" name="displayLogoFile" accept="image/*"/>
                            </div>
                            <div>
                                <label>Image communication affichage (URL ou chemin local)</label>
                                <input class="form-control" name="DisplayBackgroundImageUrl" value="@settings.DisplayBackgroundImageUrl" placeholder="/uploads/image.jpg ou https://..."/>
                                <input class="form-control mt-2" type="file" name="backgroundImageFile" accept="image/*"/>
                            </div>
                            <div>
                                <label>Vidéo communication affichage (URL ou chemin local mp4)</label>
                                <input class="form-control" name="DisplayBackgroundVideoUrl" value="@settings.DisplayBackgroundVideoUrl" placeholder="/uploads/video.mp4 ou https://.../video.mp4"/>
                                <input class="form-control mt-2" type="file" name="backgroundVideoFile" accept="video/*"/>
                            </div>
                            <div>
                                <label>Logo / image bandeau bas (URL ou chemin local)</label>
                                <input class="form-control" name="DisplayBannerImageUrl" value="@settings.DisplayBannerImageUrl" placeholder="/uploads/banner.png ou https://..."/>
                                <input class="form-control mt-2" type="file" name="bannerImageFile" accept="image/*"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="settings-section" data-settings-section="banner">
                <div class="settings-section-grid single">
                    <div class="panel">
                        <div class="panel-header"><h2><i class="bi bi-globe2 me-2" style="color:var(--accent)"></i>Langue & Bandeau défilant</h2></div>
                        <div class="panel-body vstack gap-3">
                            <div>
                                <label style="display:flex;align-items:center;gap:6px;">
                                    <i class="bi bi-translate me-1" style="color:var(--accent2)"></i>
                                    Langue par défaut au démarrage
                                </label>
                                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-top:6px;">
                                    @foreach (var (code,label,flag,native) in new[]{
                                        ("fr","Français","🇫🇷","Français"),
                                        ("ar","Arabe","🇩🇿","العربية"),
                                        ("tz","Tamazight","ⵣ","Tamaziɣt"),
                                        ("en","Anglais","🇬🇧","English")})
                                    {
                                        <label data-lang-card="@code"
                                               style="display:flex;flex-direction:column;align-items:center;gap:6px;padding:14px 8px;border-radius:12px;border:2px solid;border-color:@(settings.DefaultLanguage==code?"var(--accent)":"var(--border)");cursor:pointer;background:@(settings.DefaultLanguage==code?"linear-gradient(135deg,rgba(232,184,75,.18),rgba(129,140,248,.08))":"var(--surface2)");transition:all .2s;text-align:center;">
                                            <input type="radio" name="DefaultLanguage" value="@code" @(settings.DefaultLanguage==code?"checked":"") style="display:none;"/>
                                            <span style="font-size:1.6rem;line-height:1;">@flag</span>
                                            <span style="font-size:.86rem;font-weight:800;color:@(settings.DefaultLanguage==code?"#fff":"var(--text)")">@label</span>
                                            <span style="font-size:.7rem;color:var(--muted);font-weight:500;" dir="@(code=="ar"?"rtl":"ltr")">@native</span>
                                        </label>
                                    }
                                </div>
                                <div style="margin-top:8px;padding:8px 12px;background:rgba(232,184,75,.06);border-radius:8px;font-size:.7rem;color:var(--muted);">
                                    <i class="bi bi-info-circle me-1" style="color:var(--accent2)"></i>
                                    C'est la langue affichée par défaut sur l'écran TV et la borne. Les utilisateurs peuvent changer la langue à la prise de ticket.
                                </div>
                            </div>
                            <hr class="divider"/>
                            <div class="section-title">Bandeau défilant (bas de l'écran)</div>
                            @foreach (var (lang,ico,val) in new[]{
                                ("FR","🇫🇷",settings.DisplayBannerTextFr??""),
                                ("AR","🇩🇿",settings.DisplayBannerTextAr??""),
                                ("TZ","ⵣ",settings.DisplayBannerTextTz??""),
                                ("EN","🇬🇧",settings.DisplayBannerTextEn??"")})
                            {
                                <div>
                                    <label>@ico @lang</label>
                                    <input class="form-control" name="DisplayBannerText@lang" value="@val" placeholder="Texte bandeau @lang"/>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

        </form>

    </div>

    <!-- ═══ TAB: BORNE ═══ -->
    <div class="tab-pane @(tab=="borne"?"active":"")" id="tab-borne">
        <form asp-action="UpdateSettings" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <!-- Barre sticky : Enregistrer toujours visible -->
            <div class="settings-savebar">
                <div>
                    <div class="settings-savebar-title"><i class="bi bi-tablet me-2" style="color:var(--accent2)"></i>Borne kiosque</div>
                    <div class="settings-savebar-sub">Comportement, titres et messages de la borne client.</div>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-floppy-fill"></i> Enregistrer</button>
            </div>

            <!-- ── Suivi mobile par QR code (déplacé dans Borne kiosque v2.7.40) ─── -->
            <div class="qr-in-borne" style="margin-top:18px">
                <div class="settings-section-grid single">
                    <div class="panel">
                        <div class="panel-header"><h2><i class="bi bi-qr-code me-2" style="color:var(--accent)"></i>Suivi mobile par QR code</h2></div>
                        <div class="panel-body vstack gap-3">

                            <div class="settings-help">
                                <i class="bi bi-info-circle"></i>
                                À chaque ticket, un QR (borne + ticket) permet au client de suivre son tour sur son téléphone, même en 4G/5G.
                            </div>

                            <div class="toggle">
                                <input type="hidden" name="QrFollowEnabled" value="false"/>
                                <input type="checkbox" id="qrFollowEnabled" name="QrFollowEnabled" value="true" @(settings.QrFollowEnabled?"checked":"")/>
                                <label for="qrFollowEnabled">Activer le suivi mobile par QR code</label>
                            </div>

                            <hr class="divider"/>

                            <div>
                                <label>URL publique du suivi <span style="color:var(--muted);font-weight:400">— optionnel</span></label>
                                <input class="form-control" name="QrFollowPublicUrl"
                                       value="@(settings.QrFollowPublicUrl ?? "")"
                                       placeholder="https://suivi.nouba.app"/>
                                <div class="settings-help" style="margin-top:6px">
                                    Laissez vide pour utiliser l'URL locale de Nouba (Wi-Fi de l'établissement uniquement).
                                    Renseignez votre domaine public si vous avez déployé le serveur cloud Nouba (recommandé pour la 4G/5G).
                                </div>
                            </div>

                            <div class="grid-2">
                                <div>
                                    <label>Identifiant établissement <span style="color:var(--muted);font-weight:400">— cloud</span></label>
                                    <input class="form-control" name="QrFollowSiteId"
                                           value="@(settings.QrFollowSiteId ?? "")"
                                           placeholder="ex : agence-tizi-01"/>
                                </div>
                                <div>
                                    <label>Clé API établissement <span style="color:var(--muted);font-weight:400">— cloud</span></label>
                                    <input class="form-control" name="QrFollowApiKey" type="password"
                                           value="@(settings.QrFollowApiKey ?? "")"
                                           placeholder="••••••••••••••••"/>
                                </div>
                            </div>

                            <hr class="divider"/>

                            <div class="toggle">
                                <input type="hidden" name="QrFollowShowOnDisplay" value="false"/>
                                <input type="checkbox" id="qrFollowShowOnDisplay" name="QrFollowShowOnDisplay" value="true" @(settings.QrFollowShowOnDisplay?"checked":"")/>
                                <label for="qrFollowShowOnDisplay">Afficher un QR général sur l'écran TV</label>
                            </div>
                            <div class="settings-help" style="color:var(--warn);font-weight:600">
                                ⚠️ Pour que le QR apparaisse sur l'écran, il faut AUSSI cocher « Activer le suivi mobile par QR code » en haut. Les deux cases sont nécessaires. Pensez à recharger la page d'affichage si le changement n'apparaît pas immédiatement.
                            </div>
                            <div class="settings-help">
                                Optionnel : un QR général dans un coin de l'écran TV pointe vers <code>/suivi</code>. Le QR principal reste celui de la borne, généré à chaque ticket.
                            </div>

                        </div>
                    </div>
                </div>
            </div>


            <div class="grid-2" style="align-items:start;">
                <div class="vstack gap-4">
                    <div class="panel">
                        <div class="panel-header"><h2><i class="bi bi-tablet me-2" style="color:var(--accent)"></i>Comportement de la borne</h2></div>
                        <div class="panel-body vstack gap-3">
                            <div class="toggle">
                                <input type="hidden" name="EnableBorneAutoReturn" value="false"/>
                                <input type="checkbox" id="borneAutoReturn" name="EnableBorneAutoReturn" value="true" @(settings.EnableBorneAutoReturn?"checked":"")/>
                                <label for="borneAutoReturn">Retour automatique à l'accueil</label>
                            </div>
                            <div>
                                <label>Délai de retour (secondes)</label>
                                <input class="form-control" type="number" name="BorneAutoReturnSeconds" value="@settings.BorneAutoReturnSeconds" min="3" max="60"/>
                            </div>
                            <hr class="divider"/>
                            <div class="toggle">
                                <input type="hidden" name="EnablePriorityTickets" value="false"/>
                                <input type="checkbox" id="enablePriorityTickets" name="EnablePriorityTickets" value="true" @(settings.EnablePriorityTickets?"checked":"")/>
                                <label for="enablePriorityTickets">Activer les tickets prioritaires sur la borne</label>
                            </div>
                            <div class="toggle">
                                <input type="hidden" name="TicketsClosed" value="false"/>
                                <input type="checkbox" id="borneTicketsClosed" name="TicketsClosed" value="true" @(settings.TicketsClosed?"checked":"")/>
                                <label for="borneTicketsClosed" style="color:#fcd34d;">⚠️ Fermer la prise de ticket</label>
                            </div>
                            <hr class="divider"/>
                            <div class="toggle">
                                <input type="hidden" name="BorneShowLanguageSwitcher" value="false"/>
                                <input type="checkbox" id="borneShowLang" name="BorneShowLanguageSwitcher" value="true" @(settings.BorneShowLanguageSwitcher?"checked":"")/>
                                <label for="borneShowLang">Afficher le sélecteur de langue sur la borne</label>
                            </div>
                            <div>
                                <label>Langues disponibles <span style="color:var(--muted);font-weight:400">— cocher les langues à afficher</span></label>
                                @{
                                    var enabledLangs = (settings.BorneEnabledLanguages ?? "fr,ar,tz,en").Split(',').Select(l => l.Trim()).ToHashSet();
                                }
                                <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:6px;">
                                    @foreach (var (lcode,lname) in new[]{("fr","Français 🇫🇷"),("ar","Arabe 🇩🇿"),("tz","Tamazight ⵣ"),("en","Anglais 🇬🇧")})
                                    {
                                        <label style="display:flex;align-items:center;gap:6px;font-weight:500;cursor:pointer;">
                                            <input type="checkbox" name="BorneLangEnabled_@lcode" value="true" @(enabledLangs.Contains(lcode)?"checked":"")/>
                                            @lname
                                        </label>
                                    }
                                </div>
                                <div class="settings-help">Les langues cochées apparaissent sur la borne. Au moins une langue est toujours active.</div>
                            </div>
                        </div>
                    </div>

                    <div class="panel">
                        <div class="panel-header"><h2><i class="bi bi-card-text me-2" style="color:var(--accent)"></i>Titres de la borne</h2></div>
                        <div class="panel-body vstack gap-3">
                            @foreach (var (lang,ico) in new[]{("Fr","🇫🇷"),("Ar","🇩🇿"),("Tz","ⵣ"),("En","🇬🇧")})
                            {
                                var titleProp = typeof(Nouba.Models.UiSettings).GetProperty("BorneTitle"+lang)?.GetValue(settings)?.ToString() ?? "";
                                var subProp   = typeof(Nouba.Models.UiSettings).GetProperty("BorneSubtitle"+lang)?.GetValue(settings)?.ToString() ?? "";
                                <div class="section-title">@ico @lang.ToUpper()</div>
                                <div><label>Titre</label><input class="form-control" name="BorneTitle@lang" value="@titleProp"/></div>
                                <div><label>Sous-titre</label><input class="form-control" name="BorneSubtitle@lang" value="@subProp"/></div>
                            }
                        </div>
                    </div>
                </div>

                <div class="vstack gap-4">
                    <div class="panel">
                        <div class="panel-header"><h2><i class="bi bi-exclamation-triangle me-2" style="color:#f59e0b"></i>Message de fermeture</h2></div>
                        <div class="panel-body vstack gap-3">
                            @foreach (var (lang,ico) in new[]{("Fr","🇫🇷"),("Ar","🇩🇿"),("Tz","ⵣ"),("En","🇬🇧")})
                            {
                                var closureProp = typeof(Nouba.Models.UiSettings).GetProperty("TicketClosureMessage"+lang)?.GetValue(settings)?.ToString() ?? "";
                                <div>
                                    <label>@ico @lang.ToUpper()</label>
                                    <textarea class="form-control" name="TicketClosureMessage@lang" rows="2">@closureProp</textarea>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="panel">
                        <div class="panel-header"><h2><i class="bi bi-card-heading me-2" style="color:var(--accent)"></i>Textes affichage (titres)</h2></div>
                        <div class="panel-body vstack gap-3">
                            <div class="settings-help" style="margin-bottom:8px">
                                <i class="bi bi-info-circle"></i>
                                Le titre TV se règle dans <b>Apparence → Titre principal de l'écran TV</b>. Les champs ci-dessous ne sont qu'un rappel.
                            </div>
                            @foreach (var (lang,ico) in new[]{("Fr","🇫🇷"),("Ar","🇩🇿"),("Tz","ⵣ"),("En","🇬🇧")})
                            {
                                var dispProp   = typeof(Nouba.Models.UiSettings).GetProperty("DisplayTitle"+lang)?.GetValue(settings)?.ToString() ?? "";
                                <div class="section-title">@ico @lang.ToUpper()</div>
                                <div><label>Titre écran TV actuel</label><input class="form-control" value="@dispProp" disabled/></div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- ═══ TAB: TEXTES ═══ -->
    <div class="tab-pane @(tab=="texts"?"active":"")" id="tab-texts">
        <div class="panel">
            <div class="panel-header"><h2><i class="bi bi-translate me-2" style="color:var(--accent)"></i>Personnalisation des textes par langue</h2></div>
            <div class="panel-body">
                <p style="color:var(--muted);font-size:.85rem;margin-bottom:20px;">Titres de borne et fermeture : onglet <strong style="color:var(--text)">Borne kiosque</strong>. Bandeau et titres TV : onglet <strong style="color:var(--text)">Écran d'affichage</strong>.</p>
                <div class="grid-2" style="gap:20px;">
                    @foreach(var (lang,ico,name) in new[]{("Fr","🇫🇷","Français"),("Ar","🇩🇿","العربية"),("Tz","ⵣ","Tamazight"),("En","🇬🇧","English")})
                    {
                        <div class="qlink" style="flex-direction:column;align-items:flex-start;gap:8px;padding:16px;">
                            <div style="font-size:1.5rem;">@ico</div>
                            <div style="font-weight:700;color:#fff;">@name</div>
                            <div style="font-size:.78rem;color:var(--muted);">Borne · Affichage · Fermeture · Bandeau</div>
                            <button class="btn btn-ghost btn-sm" onclick="switchTab('borne')">Modifier →</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (isProvider)
    {
    <!-- ═══ TAB: IMPRIMANTE ═══ -->
    <div class="tab-pane @(tab=="printer"?"active":"")" id="tab-printer">

        <!-- Barre sticky : Enregistrer toujours visible.
             Le formulaire d'impression est dans la colonne gauche ; ce bouton
             le soumet via JS pour rester accessible où qu'on soit dans la page. -->
        <div class="settings-savebar">
            <div>
                <div class="settings-savebar-title"><i class="bi bi-printer me-2" style="color:var(--accent2)"></i>Imprimante</div>
                <div class="settings-savebar-sub">Mode d'impression, connexion et test rapide.</div>
            </div>
            <button type="button" class="btn btn-primary"
                    onclick="document.getElementById('printerForm')?.requestSubmit?.() || document.getElementById('printerForm')?.submit();">
                <i class="bi bi-floppy-fill"></i> Enregistrer
            </button>
        </div>

        <div class="grid-2" style="align-items:start">
            <!-- Colonne gauche : configuration principale -->
            <div class="vstack gap-4">

                <div class="panel" style="border-color:rgba(232,184,75,.3)">
                    <div class="panel-header" style="border-color:rgba(232,184,75,.2)">
                        <h2><i class="bi bi-printer me-2" style="color:#f3d486"></i>Mode d'impression</h2>
                        <p>Comment imprimer le ticket lorsqu'un client appuie sur la borne ?</p>
                    </div>
                    <div class="panel-body">
                        <form asp-controller="Printer" asp-action="SaveSettings" method="post" class="vstack gap-3" id="printerForm">
                            @Html.AntiForgeryToken()

                            <!-- Sélecteur de mode visuel -->
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                                @{
                                    var modes = new[] {
                                        ("all",          "🛡️ Tout (recommandé)", "ESC/POS direct + repli navigateur. Fiabilité maximale."),
                                        ("escpos",       "⚡ ESC/POS (réseau)",   "Imprimante thermique TCP — instantané, sans navigateur."),
                                        ("chrome-kiosk", "🖥️ Chrome kiosque",     "Impression silencieuse via Chrome --kiosk-printing."),
                                        ("browser",      "🪟 Fenêtre d'impression","Demande de confirmation du navigateur.")
                                    };
                                }
                                @foreach (var (val, label, desc) in modes)
                                {
                                    var selected = (settings.PrintMode ?? "all") == val;
                                    <label style="cursor:pointer;display:block;padding:14px;border-radius:14px;border:2px solid @(selected?"var(--accent)":"var(--border)");background:@(selected?"rgba(232,184,75,.12)":"var(--surface2)");transition:all .15s">
                                        <input type="radio" name="printMode" value="@val" @(selected?"checked":"") style="display:none" onchange="document.querySelectorAll('#printerForm label[data-mode]').forEach(l=>{l.style.borderColor='var(--border)';l.style.background='var(--surface2)';});this.closest('label').style.borderColor='var(--accent)';this.closest('label').style.background='rgba(232,184,75,.12)'"/>
                                        <span data-mode="@val" style="display:none"></span>
                                        <div style="font-weight:800;font-size:.92rem;color:#fff;margin-bottom:4px">@label</div>
                                        <div style="font-size:.74rem;color:var(--muted);line-height:1.4">@desc</div>
                                    </label>
                                }
                            </div>

                            <hr class="divider"/>

                            <!-- Activation globale -->
                            <div class="toggle">
                                <input type="checkbox" id="printerEnabled" name="printerEnabled" value="true" @(settings.PrinterEnabled?"checked":"")/>
                                <label for="printerEnabled">Activer la connexion à l'imprimante ESC/POS</label>
                            </div>

                            <hr class="divider"/>

                            <!-- ── Type de connexion ESC/POS (Réseau / USB / Série) ── -->
                            <div>
                                <label style="font-weight:700;color:#cbd5e1;text-transform:uppercase;letter-spacing:.05em;font-size:.78rem;margin-bottom:8px">
                                    <i class="bi bi-plug"></i> Type de connexion à l'imprimante
                                </label>
                                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px">
                                    @{
                                        var connections = new[] {
                                            ("network", "🌐 Réseau (TCP)",  "IP fixe — universel"),
                                            ("usb",     "🔌 USB / Windows", "Pilote installé"),
                                            ("serial",  "📡 Série COM",     "Vieilles bornes")
                                        };
                                        var selectedConn = (settings.PrinterConnection ?? "network");
                                    }
                                    @foreach (var (val, label, hint) in connections)
                                    {
                                        var sel = selectedConn == val;
                                        <label style="cursor:pointer;display:block;padding:10px;border-radius:10px;border:2px solid @(sel?"#f3d486":"var(--border)");background:@(sel?"rgba(232,184,75,.12)":"var(--surface2)");text-align:center;transition:all .15s" data-conn-card="@val">
                                            <input type="radio" name="printerConnection" value="@val" @(sel?"checked":"") onchange="updateConnUi()" style="display:none"/>
                                            <div style="font-weight:700;font-size:.84rem;color:#fff;margin-bottom:2px">@label</div>
                                            <div style="font-size:.7rem;color:var(--muted)">@hint</div>
                                        </label>
                                    }
                                </div>
                            </div>

                            <!-- Champs spécifiques RÉSEAU -->
                            <div id="connFieldsNetwork" data-conn-fields="network">
                                <div class="grid-2" style="gap:12px">
                                    <div>
                                        <label>Adresse IP de l'imprimante</label>
                                        <input class="form-control" name="printerIp" value="@settings.PrinterIp" placeholder="192.168.1.100" data-testid="printer-ip-input"/>
                                    </div>
                                    <div>
                                        <label>Port TCP</label>
                                        <input class="form-control" name="printerPort" type="number" min="1" max="65535" value="@settings.PrinterPort" placeholder="9100" data-testid="printer-port-input"/>
                                    </div>
                                </div>
                                <div style="background:rgba(232,184,75,.06);border:1px solid rgba(232,184,75,.18);border-radius:10px;padding:10px 14px;margin-top:8px;font-size:.78rem;color:#a5b4fc;line-height:1.55">
                                    <i class="bi bi-info-circle"></i>
                                    Le port standard <b>9100</b> est universel (« RAW » / « Direct Print »). Configurez une IP fixe sur l'imprimante (cf. manuel) puis testez ci-dessous.
                                </div>
                            </div>

                            <!-- Champs spécifiques USB -->
                            <div id="connFieldsUsb" data-conn-fields="usb" style="display:none">
                                <label>Imprimante Windows installée</label>
                                <div style="display:flex;gap:8px">
                                    <select class="form-select" id="printerNameSelect" style="flex:1" onchange="document.getElementById('printerNameInfo').value=this.value">
                                        <option value="@settings.PrinterName" selected>@(string.IsNullOrWhiteSpace(settings.PrinterName) ? "— Cliquez sur Détecter pour lister vos imprimantes —" : settings.PrinterName)</option>
                                    </select>
                                    <button type="button" class="btn btn-ghost" style="white-space:nowrap" onclick="detectPrinters()">
                                        <i class="bi bi-arrow-clockwise"></i> Détecter
                                    </button>
                                </div>
                                <div style="background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.2);border-radius:10px;padding:10px 14px;margin-top:8px;font-size:.78rem;color:#fbbf24;line-height:1.55">
                                    <i class="bi bi-lightbulb"></i>
                                    Avant de détecter, l'imprimante doit être installée dans Windows
                                    (<b>Paramètres → Imprimantes et scanners → Ajouter une imprimante</b>).
                                    Pour les imprimantes thermiques, le pilote « <i>Generic / Text Only</i> » fonctionne très bien.
                                </div>
                            </div>

                            <!-- Champs spécifiques SÉRIE -->
                            <div id="connFieldsSerial" data-conn-fields="serial" style="display:none">
                                <div class="grid-2" style="gap:12px">
                                    <div>
                                        <label>Port COM</label>
                                        <div style="display:flex;gap:6px">
                                            <input class="form-control" id="printerComPortInput" name="printerComPort" value="@settings.PrinterComPort" placeholder="COM3" style="flex:1"/>
                                            <select class="form-select" id="printerComPortSelect" style="flex:1;display:none" onchange="document.getElementById('printerComPortInput').value=this.value"></select>
                                            <button type="button" class="btn btn-ghost" onclick="detectPrinters()" title="Détecter les ports COM disponibles"><i class="bi bi-arrow-clockwise"></i></button>
                                        </div>
                                    </div>
                                    <div>
                                        <label>Vitesse (bauds)</label>
                                        <select class="form-select" name="printerBaudRate">
                                            @foreach (var rate in new[] { 9600, 19200, 38400, 57600, 115200 })
                                            {
                                                <option value="@rate" selected="@(settings.PrinterBaudRate == rate ? "selected" : null)">@rate</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <hr class="divider"/>

                            <div class="grid-2" style="gap:12px">
                                <div>
                                    <label>Nom / modèle (informatif)</label>
                                    <input class="form-control" name="printerName" value="@settings.PrinterName" placeholder="Epson TM-T20III" id="printerNameInfo" data-info="true"/>
                                    <div style="font-size:.7rem;color:var(--muted);margin-top:3px">⚠️ En mode USB, ce champ doit correspondre au nom <b>exact</b> de l'imprimante Windows. Utilisez le bouton « Détecter » pour le sélectionner.</div>
                                </div>
                                <div>
                                    <label>Largeur papier (mm)</label>
                                    <select class="form-select" name="ticketWidth">
                                        <!option value="58" selected="@(settings.TicketWidth==58?"selected":null)">58 mm (mini)</!option>
                                        <!option value="80" selected="@(settings.TicketWidth==80?"selected":null)">80 mm (standard)</!option>
                                    </select>
                                </div>
                            </div>

                            <div>
                                <label>Délai d'attente connexion (ms) — actuel : <span id="timeoutVal">@settings.PrinterTimeoutMs</span></label>
                                <input type="range" name="printerTimeoutMs" min="500" max="10000" step="500" value="@settings.PrinterTimeoutMs" oninput="document.getElementById('timeoutVal').textContent=this.value"/>
                                <div style="font-size:.72rem;color:var(--muted);margin-top:4px">Au-delà de ce délai, on n'attend plus l'imprimante (évite de bloquer le client).</div>
                            </div>

                            <hr class="divider"/>

                            <div class="grid-2" style="gap:12px">
                                <div class="toggle">
                                    <input type="checkbox" id="printerAutoCut" name="printerAutoCut" value="true" @(settings.PrinterAutoCut?"checked":"")/>
                                    <label for="printerAutoCut">Couper le papier après impression</label>
                                </div>
                                <div class="toggle">
                                    <input type="checkbox" id="printerBeep" name="printerBeep" value="true" @(settings.PrinterBeep?"checked":"")/>
                                    <label for="printerBeep">Bip sonore après impression</label>
                                </div>
                                <div class="toggle">
                                    <input type="checkbox" id="ticketShowLogo" name="ticketShowLogo" value="true" @(settings.TicketShowLogo?"checked":"")/>
                                    <label for="ticketShowLogo">Afficher le logo client</label>
                                </div>
                                <div class="toggle">
                                    <input type="checkbox" id="ticketShowQr" name="ticketShowQr" value="true" @(settings.TicketShowQr?"checked":"")/>
                                    <label for="ticketShowQr">QR code numéro de ticket</label>
                                </div>
                                <div class="toggle">
                                    <input type="checkbox" id="ticketShowNoubaFooter" name="ticketShowNoubaFooter" value="true" @(settings.TicketShowNoubaFooter?"checked":"")/>
                                    <label for="ticketShowNoubaFooter">Mention « Nouba Pro » en pied</label>
                                </div>
                            </div>

                            <hr class="divider"/>

                            <h4 style="font-size:.85rem;color:var(--accent2);margin-bottom:6px">Message de pied de ticket (par langue)</h4>
                            <div class="grid-2" style="gap:10px">
                                <div><label>Français</label><input class="form-control" name="ticketFooterFr" value="@settings.TicketFooterFr" placeholder="Merci de votre visite"/></div>
                                <div><label>العربية</label><input class="form-control" name="ticketFooterAr" value="@settings.TicketFooterAr" dir="rtl" placeholder="شكرا لزيارتكم"/></div>
                                <div><label>Tamazight</label><input class="form-control" name="ticketFooterTz" value="@settings.TicketFooterTz" placeholder="Tanemmirt..."/></div>
                                <div><label>English</label><input class="form-control" name="ticketFooterEn" value="@settings.TicketFooterEn" placeholder="Thank you..."/></div>
                            </div>

                            <hr class="divider"/>

                            <h4 style="font-size:.85rem;color:var(--accent2);margin-bottom:6px">Logos sur le rapport PDF</h4>
                            <div class="grid-2" style="gap:12px">
                                <div class="toggle">
                                    <input type="checkbox" id="reportShowClientLogo" name="reportShowClientLogo" value="true" @(settings.ReportShowClientLogo?"checked":"")/>
                                    <label for="reportShowClientLogo">Logo du client (haut gauche)</label>
                                </div>
                                <div class="toggle">
                                    <input type="checkbox" id="reportShowNoubaLogo" name="reportShowNoubaLogo" value="true" @(settings.ReportShowNoubaLogo?"checked":"")/>
                                    <label for="reportShowNoubaLogo">Logo Nouba (haut droite)</label>
                                </div>
                            </div>

                            <hr class="divider"/>
                            <h4 style="font-size:.85rem;color:var(--accent2);margin-bottom:6px">🔔 Monitoring &amp; alertes</h4>
                            <div class="toggle">
                                <input type="checkbox" id="printerMonitoringEnabled" name="printerMonitoringEnabled" value="true" @(settings.PrinterMonitoringEnabled?"checked":"")/>
                                <label for="printerMonitoringEnabled">Surveiller en continu (papier, capot, hors-ligne)</label>
                            </div>
                            <div class="toggle">
                                <input type="checkbox" id="printerAlertSound" name="printerAlertSound" value="true" @(settings.PrinterAlertSound?"checked":"")/>
                                <label for="printerAlertSound">Son d'alerte dans l'admin en cas de défaut</label>
                            </div>
                            <div>
                                <label>Intervalle de vérification (secondes) — actuel : <span id="monIntervalVal">@settings.PrinterMonitorIntervalSec</span></label>
                                <input type="range" name="printerMonitorIntervalSec" min="10" max="300" step="10" value="@settings.PrinterMonitorIntervalSec" oninput="document.getElementById('monIntervalVal').textContent=this.value"/>
                            </div>

                            <button type="submit" class="btn btn-primary btn-w" style="margin-top:12px" data-testid="save-printer-settings-btn">
                                <i class="bi bi-save"></i> Enregistrer les paramètres d'impression
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Colonne droite : test + état + diagnostic -->
            <div class="vstack gap-4">

                <div class="panel" style="border-color:rgba(34,197,94,.25)">
                    <div class="panel-header" style="border-color:rgba(34,197,94,.2)">
                        <h2><i class="bi bi-broadcast me-2" style="color:#34d399"></i>Test &amp; diagnostic</h2>
                        <p>Vérifiez que l'imprimante répond avant la mise en production.</p>
                    </div>
                    <div class="panel-body vstack gap-3">

                        <div id="printerStatusBox" style="padding:12px 14px;border-radius:12px;background:rgba(255,255,255,.04);border:1px solid var(--border);font-size:.84rem;color:var(--muted);display:flex;align-items:center;gap:10px">
                            <span id="printerStatusDot" style="width:10px;height:10px;border-radius:50%;background:#94a3b8"></span>
                            <span id="printerStatusText">Cliquez sur « Tester la connexion » pour vérifier</span>
                        </div>

                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                            <button type="button" class="btn btn-ghost btn-w" onclick="pingPrinter()" data-testid="ping-printer-btn">
                                <i class="bi bi-wifi"></i> Tester la connexion
                            </button>
                            <form asp-controller="Printer" asp-action="TestPrint" method="post" style="margin:0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-primary btn-w" data-testid="test-print-btn">
                                    <i class="bi bi-printer"></i> Imprimer ticket de test
                                </button>
                            </form>
                        </div>

                        <div style="background:rgba(232,184,75,.06);border:1px solid rgba(232,184,75,.2);border-radius:10px;padding:12px 14px;font-size:.78rem;color:#c7d2fe;line-height:1.55">
                            <strong>Astuce :</strong> la plupart des imprimantes thermiques réseau écoutent sur le port <code>9100</code>.<br/>
                            <strong>Marques compatibles :</strong> Epson TM-T20/T82/T88, Star TSP, Bixolon SRP, Xprinter, SNBC.<br/>
                            <strong>Mode kiosque Chrome :</strong> lancer <code>chrome --kiosk --kiosk-printing --app=http://127.0.0.1:5000/Borne</code>
                        </div>
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-header"><h2><i class="bi bi-info-circle me-2" style="color:var(--accent)"></i>Comment ça marche ?</h2></div>
                    <div class="panel-body" style="font-size:.84rem;color:var(--muted);line-height:1.6">
                        <div style="margin-bottom:10px"><strong style="color:#fff">Mode « Tout »</strong> : on essaie d'abord l'imprimante ESC/POS via TCP. Si elle ne répond pas en moins de @settings.PrinterTimeoutMs ms, on bascule automatiquement sur l'impression navigateur. <span style="color:#34d399">Recommandé.</span></div>
                        <div style="margin-bottom:10px"><strong style="color:#fff">Mode « ESC/POS »</strong> : envoi binaire direct (octets ESC/POS) sur l'IP de l'imprimante. Aucun navigateur impliqué — réponse en moins de 100 ms en LAN.</div>
                        <div style="margin-bottom:10px"><strong style="color:#fff">Mode « Chrome kiosque »</strong> : la borne tourne sous Chrome avec <code>--kiosk-printing</code>. Le ticket s'imprime sur l'imprimante par défaut Windows sans dialogue.</div>
                        <div><strong style="color:#fff">Mode « Fenêtre d'impression »</strong> : la fenêtre d'impression apparaît à chaque ticket. À utiliser si l'impression silencieuse n'est pas configurée.</div>
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-header"><h2><i class="bi bi-life-preserver me-2" style="color:var(--accent)"></i>En cas de problème</h2></div>
                    <div class="panel-body" style="font-size:.82rem;color:var(--muted);line-height:1.6">
                        <ol style="padding-left:1.2em;margin:0">
                            <li>Vérifiez que l'imprimante est <strong style="color:#fff">allumée</strong> et connectée au même réseau LAN que la borne.</li>
                            <li>Sur l'imprimante, imprimez le ticket de configuration pour lire son IP (souvent en maintenant le bouton FEED appuyé à l'allumage).</li>
                            <li>Saisissez l'IP exacte ci-contre. Le port est presque toujours <code>9100</code>.</li>
                            <li>Cliquez sur <strong style="color:#fff">« Tester la connexion »</strong> puis <strong style="color:#fff">« Imprimer ticket de test »</strong>.</li>
                            <li>Si rien ne sort, vérifiez le pare-feu Windows et que l'imprimante est sur le profil <em>Réseau privé</em>.</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ═══ TAB: DIAGNOSTIC ═══ -->
    <div class="tab-pane @(tab=="diagnostic"?"active":"")" id="tab-diagnostic">
        <div class="settings-savebar">
            <div>
                <div class="settings-savebar-title"><i class="bi bi-activity me-2" style="color:var(--accent2)"></i>Diagnostic guidé</div>
                <div class="settings-savebar-sub">Contrôle rapide imprimante, audio, voix, borne et système avec messages clairs.</div>
            </div>
            <button type="button" class="btn btn-primary" onclick="runDiagnostics()"><i class="bi bi-arrow-clockwise"></i> Relancer le diagnostic</button>
        </div>
        <div class="grid-2" style="align-items:start;">
            <div class="panel">
                <div class="panel-header"><h2><i class="bi bi-check2-circle me-2" style="color:#22c55e"></i>État système</h2></div>
                <div class="panel-body" id="diagnosticCards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;">
                    <div class="mini-status-card"><strong>Système</strong><span>Diagnostic en cours…</span></div>
                    <div class="mini-status-card"><strong>Voix</strong><span>Diagnostic en cours…</span></div>
                    <div class="mini-status-card"><strong>Imprimante</strong><span>Diagnostic en cours…</span></div>
                    <div class="mini-status-card"><strong>Borne</strong><span>Diagnostic en cours…</span></div>
                </div>
            </div>
            <div class="panel">
                <div class="panel-header"><h2><i class="bi bi-magic me-2" style="color:var(--accent)"></i>Tests rapides</h2></div>
                <div class="panel-body vstack gap-3">
                    <button type="button" class="btn btn-ghost" onclick="testVoice('fr')"><i class="bi bi-volume-up"></i> Tester voix française</button>
                    <button type="button" class="btn btn-ghost" onclick="testBrowserAudio()"><i class="bi bi-speaker"></i> Tester audio navigateur</button>
