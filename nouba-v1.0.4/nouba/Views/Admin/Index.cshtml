        <script>
        async function aiLoadSummary(){
            try{
                var r = await fetch('/Ai/Summary');
                var s = await r.json();
                var box = document.getElementById('aiSummaryBox');
                if(!s || s.total === 0){
                    box.innerHTML = '<div style="color:#94a3b8;font-style:italic"><i class="bi bi-info-circle"></i> Aucune activité enregistrée aujourd\'hui.</div>';
                    document.getElementById('aiRecos').innerHTML = '';
                    return;
                }
                box.innerHTML = '<div style="color:#fff;font-size:1rem;line-height:1.55"><i class="bi bi-stars" style="color:#c084fc"></i> <b>' + s.headlineFr + '</b></div>';
                var recosBox = document.getElementById('aiRecos');
                if(s.recommendations && s.recommendations.length){
                    var html = '<div style="font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:#c084fc;font-weight:700;margin-bottom:6px"><i class="bi bi-lightbulb"></i> Recommandations</div>';
                    html += '<div style="display:flex;flex-direction:column;gap:6px">';
                    s.recommendations.forEach(function(r){
                        html += '<div style="padding:8px 12px;background:rgba(168,85,247,.06);border-left:3px solid #c084fc;border-radius:6px;font-size:.84rem;color:#e9d5ff">' + r + '</div>';
                    });
                    html += '</div>';
                    recosBox.innerHTML = html;
                } else recosBox.innerHTML = '';
            } catch(e){
                document.getElementById('aiSummaryBox').innerHTML = '<div style="color:#fca5a5">Erreur de chargement IA : ' + e.message + '</div>';
            }
        }
        function aiOpenReport(){ window.open('/Ai/Report', '_blank'); }
        // Auto-charge au chargement de la page (uniquement si l'onglet dashboard est actif)
        if(document.getElementById('tab-dashboard').classList.contains('active')) aiLoadSummary();
        </script>

