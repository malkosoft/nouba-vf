<script>
(function(){
  var langMap = { Fr: 'fr', Ar: 'ar', Tz: 'tz', En: 'en' };

  function syncDisplayTitleShadows(input){
    var suffix = input.getAttribute('data-display-header-title');
    if (!suffix) return;
    document.querySelectorAll('[data-display-title-shadow="' + suffix + '"], [data-header-title-shadow="' + suffix + '"]').forEach(function(shadow){
      shadow.value = input.value.trim();
    });
  }

  async function saveDisplayHeaderTitle(input){
    var suffix = input.getAttribute('data-display-header-title');
    if (!suffix) return;

    syncDisplayTitleShadows(input);

    var value = input.value.trim();
    var lastSaved = input.getAttribute('data-last-saved-title') || '';
    var status = document.querySelector('[data-display-title-status="' + suffix + '"]');
    if (value === lastSaved) return;

    var form = input.closest('form');
    var token = form ? form.querySelector('input[name="__RequestVerificationToken"]') : null;
    if (!form || !token) return;

    if (status) {
      status.textContent = 'Enregistrement du titre...';
      status.style.color = 'var(--muted)';
    }

    var body = new FormData();
    body.append('__RequestVerificationToken', token.value);
    body.append('lang', langMap[suffix] || 'fr');
    body.append('title', value);

    try {
      var response = await fetch('/Admin/UpdateDisplayHeaderTitle', {
        method: 'POST',
        body: body,
        credentials: 'same-origin',
        cache: 'no-store'
      });

      if (!response.ok) throw new Error('HTTP ' + response.status);
      var data = await response.json();
      if (!data || !data.ok) throw new Error('Réponse invalide');

      input.setAttribute('data-last-saved-title', value);
      if (status) {
        status.textContent = 'Titre enregistré';
        status.style.color = '#86efac';
      }
    } catch (error) {
      if (status) {
        status.textContent = 'Non enregistré - cliquez sur Enregistrer';
        status.style.color = '#fca5a5';
      }
    }
  }

  document.querySelectorAll('[data-display-header-title]').forEach(function(input){
    input.addEventListener('input', function(){ syncDisplayTitleShadows(input); });
    input.addEventListener('change', function(){ saveDisplayHeaderTitle(input); });
    input.addEventListener('blur', function(){ saveDisplayHeaderTitle(input); });
    input.addEventListener('keydown', function(event){
      if (event.key === 'Enter') {
        event.preventDefault();
        saveDisplayHeaderTitle(input);
      }
    });
  });

  document.querySelectorAll('[data-display-settings-form]').forEach(function(form){
    form.addEventListener('submit', function(){
      form.querySelectorAll('[data-display-header-title]').forEach(syncDisplayTitleShadows);
    });
  });
})();

document.querySelectorAll('[data-settings-tabs]').forEach(function(group){
  group.querySelectorAll('.settings-tab').forEach(function(btn){
    btn.addEventListener('click', function(){
      var root = btn.closest('.tab-pane');
      var target = btn.getAttribute('data-settings-target');
      group.querySelectorAll('.settings-tab').forEach(function(b){ b.classList.toggle('active', b === btn); });
      root.querySelectorAll('[data-settings-section]').forEach(function(section){
        section.classList.toggle('active', section.getAttribute('data-settings-section') === target);
      });
    });
  });
});

// ── Sélecteur d'emojis pour les services ──────────────────────────────
// Gère la sélection visuelle et reporte l'emoji choisi dans le champ caché.
(function(){
  function wireEmojiPicker(pickerId, hiddenId){
    var picker = document.getElementById(pickerId);
    var hidden = document.getElementById(hiddenId);
    if(!picker || !hidden) return;
    picker.addEventListener('click', function(e){
      var btn = e.target.closest('.emoji-opt');
      if(!btn) return;
      picker.querySelectorAll('.emoji-opt').forEach(function(b){ b.classList.remove('is-selected'); });
      btn.classList.add('is-selected');
      hidden.value = btn.getAttribute('data-emoji') || '';
    });
  }
  wireEmojiPicker('newEmojiPicker', 'newServiceEmoji');
})();

// ── Modale Nouba : remplace alert()/confirm() natifs ──────────────────
(function(){
  var overlay = document.getElementById('noubaModal');
  if(!overlay) return;
  var box = overlay.querySelector('.nmodal');
  var iconEl = document.getElementById('nmodalIcon');
  var titleEl = document.getElementById('nmodalTitle');
  var msgEl = document.getElementById('nmodalMessage');
  var okBtn = document.getElementById('nmodalConfirm');
  var cancelBtn = document.getElementById('nmodalCancel');
  var resolver = null;

  function close(result){
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden','true');
    var r = resolver; resolver = null;
    if(r) r(result);
  }
  okBtn.addEventListener('click', function(){ close(true); });
  cancelBtn.addEventListener('click', function(){ close(false); });
  overlay.addEventListener('click', function(e){ if(e.target === overlay) close(false); });
  document.addEventListener('keydown', function(e){
    if(!overlay.classList.contains('open')) return;
    if(e.key === 'Escape') close(false);
    if(e.key === 'Enter') close(true);
  });

  // API publique : retourne une Promise<bool>.
  window.noubaConfirm = function(message, opts){
    opts = opts || {};
    return new Promise(function(resolve){
      resolver = resolve;
      box.classList.toggle('is-danger', !!opts.danger);
      box.classList.remove('is-alert');
      iconEl.textContent = opts.icon || (opts.danger ? '🗑️' : '⚠️');
      titleEl.textContent = opts.title || 'Confirmer';
      msgEl.textContent = message || '';
      okBtn.textContent = opts.confirmText || (opts.danger ? 'Supprimer' : 'Confirmer');
      cancelBtn.textContent = opts.cancelText || 'Annuler';
      overlay.classList.add('open');
      overlay.setAttribute('aria-hidden','false');
      setTimeout(function(){ okBtn.focus(); }, 50);
    });
  };
  window.noubaAlert = function(message, opts){
    opts = opts || {};
    return new Promise(function(resolve){
      resolver = resolve;
      box.classList.add('is-alert');
      box.classList.remove('is-danger');
      iconEl.textContent = opts.icon || (opts.error ? '❌' : '✅');
      titleEl.textContent = opts.title || (opts.error ? 'Erreur' : 'Information');
      msgEl.textContent = message || '';
      okBtn.textContent = opts.confirmText || 'OK';
      overlay.classList.add('open');
      overlay.setAttribute('aria-hidden','false');
      setTimeout(function(){ okBtn.focus(); }, 50);
    });
  };

  // Intercepte les formulaires avec data-confirm pour afficher la modale.
  document.addEventListener('submit', function(e){
    var form = e.target;
    if(!form || !form.getAttribute) return;
    var msg = form.getAttribute('data-confirm');
    if(!msg || form.dataset.noubaConfirmed === '1') return;
    e.preventDefault();
    var danger = form.getAttribute('data-confirm-danger') === '1';
    var title = form.getAttribute('data-confirm-title') || (danger ? 'Supprimer' : 'Confirmer');
    window.noubaConfirm(msg, { danger: danger, title: title }).then(function(ok){
      if(ok){ form.dataset.noubaConfirmed = '1'; form.submit(); }
    });
  }, true);
})();
</script>
</body>
</html>
