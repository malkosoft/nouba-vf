            <div class="panel-body">
                <div id="aiSummaryBox" style="padding:16px;background:rgba(15,23,42,.4);border:1px solid var(--border);border-radius:12px;font-size:.92rem;color:#cbd5e1;line-height:1.6;min-height:60px">
