            <!-- Widget statut imprimante temps réel (fournisseur uniquement) -->
            @if (isProvider)
            {
            <a href="?tab=printer" id="topPrinterStatus" title="Cliquer pour configurer" style="display:flex;align-items:center;gap:8px;padding:6px 12px;border-radius:10px;background:rgba(255,255,255,.04);border:1px solid var(--border);text-decoration:none;font-size:.78rem;color:#cbd5e1;font-weight:600">
                <span id="topPrinterDot" style="width:10px;height:10px;border-radius:50%;background:#94a3b8;transition:all .3s"></span>
                <span id="topPrinterLabel">Imprimante…</span>
            </a>
            }
            @{
                string tunnelStatus = ViewBag.TunnelStatus as string ?? "initializing";
                string? tunnelUrl   = ViewBag.TunnelUrl as string;
                var (tunnelColor, tunnelTitle, tunnelLabel) = tunnelStatus switch {
                    "running"     => ("#34d399", tunnelUrl ?? "", "QR internet actif"),
                    "starting"    => ("#fbbf24", "Démarrage du tunnel…", "QR tunnel…"),
                    "restarting"  => ("#fbbf24", "Redémarrage du tunnel dans 30 s…", "QR tunnel…"),
                    "not_found"   => ("#475569", "cloudflared.exe introuvable — suivi QR limité au Wi-Fi local", "QR local"),
                    "no_internet" => ("#475569", "Pas de connexion internet — tunnel non démarré", "QR local"),
                    "error"       => ("#f87171", "Erreur tunnel Cloudflare", "QR erreur"),
                    _             => ("#475569", "Initialisation du tunnel…", "QR…"),
                };
            }
            <div title="@tunnelTitle" style="display:flex;align-items:center;gap:7px;padding:6px 12px;border-radius:10px;background:rgba(255,255,255,.04);border:1px solid var(--border);font-size:.78rem;color:#cbd5e1;font-weight:600;cursor:default">
                <span style="width:9px;height:9px;border-radius:50%;background:@tunnelColor;flex-shrink:0"></span>
                @tunnelLabel
            </div>
            <div id="clock" style="font-size:.85rem;color:var(--muted);font-weight:600;min-width:80px;text-align:right;"></div>
            <button class="topbar-btn" onclick="location.reload()"><i class="bi bi-arrow-clockwise"></i> Actualiser</button>
            <a href="/Admin/ExportStats" class="topbar-btn primary"><i class="bi bi-download"></i> Export CSV</a>
        </div>
    </div>

@if (sysHasAlert)
{
    <div id="sysAlertBanner" style="margin:12px 24px 0;padding:12px 18px;border-radius:12px;display:flex;align-items:flex-start;gap:12px;
        background:@(sysDbOk ? "rgba(251,191,36,.08)" : "rgba(248,113,113,.08)");
        border:1px solid @(sysDbOk ? "rgba(251,191,36,.35)" : "rgba(248,113,113,.35)");">
