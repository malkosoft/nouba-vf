function setVoiceGenderStatus(text, ok){
    var status = document.getElementById('voiceGenderSaveStatus');
    if(!status) return;
    status.textContent = text || '';
    status.style.color = ok === true ? '#86efac' : ok === false ? '#fca5a5' : 'var(--muted)';
}

function saveVoiceGender(gender){
    var form = document.querySelector('[data-display-settings-form]');
    var token = form ? form.querySelector('input[name="__RequestVerificationToken"]') : null;
    if(!token) return;

    setVoiceGenderStatus('Enregistrement du genre...', null);
    var body = new FormData();
    body.append('__RequestVerificationToken', token.value);
    body.append('voiceGender', gender);

    fetch('/Admin/UpdateVoiceGender', {
        method: 'POST',
        body: body,
        credentials: 'same-origin',
        cache: 'no-store'
    })
    .then(r=>{ if(!r.ok) throw new Error('HTTP '+r.status); return r.json(); })
    .then(d=>{
        if(!d || !d.ok) throw new Error('Reponse invalide');
        setVoiceGenderStatus(gender === 'male' ? 'Genre masculin enregistre' : 'Genre feminin enregistre', true);
    })
    .catch(()=>setVoiceGenderStatus('Genre non enregistre - cliquez sur Enregistrer', false));
}

document.querySelectorAll('[data-voice-gender-input]').forEach(function(input){
    input.addEventListener('change', function(){
        if(input.checked) saveVoiceGender(input.value);
        refreshVoiceGenderCards();
