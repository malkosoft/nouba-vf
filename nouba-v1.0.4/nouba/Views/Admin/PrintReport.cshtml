@using Nouba.Models
@using Nouba.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext _ctx
@{
    Layout = null;
    string siteName = ViewBag.SiteName as string ?? "Nouba";
    string date = ViewBag.Date as string ?? DateTime.Today.ToString("dd/MM/yyyy");
    var tickets = ViewBag.Tickets as List<Ticket> ?? new();
    var services = ViewBag.Services as List<ServiceType> ?? new();
    var histories = ViewBag.Histories as List<CallHistory> ?? new();
    int total = (int)(ViewBag.TotalToday ?? 0);
    int served = (int)(ViewBag.ServedToday ?? 0);
    int absent = (int)(ViewBag.AbsentToday ?? 0);
    int waiting = (int)(ViewBag.WaitingNow ?? 0);
    int called = (int)(ViewBag.CalledNow ?? 0);
    double avgWait = (double)(ViewBag.AvgWaitMinutes ?? 0.0);

    // Lecture directe pour récupérer les flags logos + URL logo client.
    var s = await _ctx.UiSettings.AsNoTracking().FirstAsync();
    string? clientLogo = s.HeaderImageUrl;
    bool showClientLogo = s.ReportShowClientLogo && !string.IsNullOrWhiteSpace(clientLogo);
    bool showNoubaLogo  = s.ReportShowNoubaLogo;
}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8"/>
<title>@siteName — Rapport journalier @date</title>
<link rel="icon" type="image/png" href="~/images/favicon.png"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:"Segoe UI","Helvetica Neue",Arial,sans-serif;font-size:10pt;color:#1a202c;background:#fff;padding:12mm}

/* ── En-tête avec logos ── */
.report-header{
  display:grid;grid-template-columns:auto 1fr auto;gap:14mm;
  align-items:center;
  padding-bottom:6mm;margin-bottom:6mm;
  border-bottom:2px solid #0f172a;
}
.report-header .logo-box{display:flex;align-items:center;justify-content:center;height:22mm}
.report-header .logo-box img{max-height:22mm;max-width:38mm;object-fit:contain}
.report-header .logo-placeholder{font-size:9pt;color:#94a3b8;font-style:italic}
.report-header .title-block{text-align:center}
.report-header h1{font-size:17pt;font-weight:800;color:#0f172a;letter-spacing:-.01em;margin-bottom:2mm}
.report-header .subtitle{font-size:9pt;color:#64748b;font-weight:500}
.report-header .badge-date{display:inline-block;margin-top:1mm;padding:1mm 4mm;background:#0f172a;color:#fff;border-radius:3mm;font-size:8.5pt;font-weight:700;letter-spacing:.04em}

h1{font-size:16pt;font-weight:800;color:#0f172a;margin-bottom:2mm}
.subtitle{font-size:9pt;color:#64748b;margin-bottom:6mm}
.kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:3mm;margin-bottom:7mm}
.kpi{border:1px solid #e2e8f0;border-radius:3mm;padding:3mm 4mm;text-align:center}
.kpi-val{font-size:18pt;font-weight:900;color:#0f172a}
.kpi-label{font-size:7.5pt;color:#64748b;margin-top:1mm}
.kpi.green .kpi-val{color:#065f46}.kpi.red .kpi-val{color:#9b1c1c}.kpi.blue .kpi-val{color:#1e3a5f}.kpi.yellow .kpi-val{color:#78350f}
h2{font-size:11pt;font-weight:700;color:#0f172a;margin:5mm 0 2mm;border-bottom:1px solid #e2e8f0;padding-bottom:1.5mm}
table{width:100%;border-collapse:collapse;margin-bottom:6mm;font-size:8.5pt}
th{background:#f1f5f9;font-weight:700;text-align:left;padding:2mm 3mm;border:1px solid #e2e8f0;font-size:8pt}
td{padding:2mm 3mm;border:1px solid #e2e8f0;vertical-align:middle}
tr:nth-child(even) td{background:#fafafa}
.badge{display:inline-block;padding:0.5mm 2.5mm;border-radius:20px;font-size:7.5pt;font-weight:700}
.b-wait{background:#dbeafe;color:#1e3a5f}.b-done{background:#d1fae5;color:#065f46}
.b-absent{background:#fee2e2;color:#9b1c1c}.b-called{background:#fef3c7;color:#78350f}
.b-priority{background:#fde68a;color:#92400e}
.footer{margin-top:8mm;text-align:center;font-size:7.5pt;color:#94a3b8;border-top:1px solid #e2e8f0;padding-top:4mm}
.no-print{margin-bottom:6mm}
.print-btn{padding:10px 28px;border-radius:10px;border:none;background:#0f766e;color:#fff;font-weight:700;font-size:10pt;cursor:pointer}
@@media print{
  .no-print{display:none!important}
  body{padding:8mm}
  .report-header{break-inside:avoid}
}
</style>
</head>
<body>
<div class="no-print">
  <button class="print-btn" onclick="window.print()">🖨️ Imprimer / Enregistrer en PDF</button>
  &nbsp;&nbsp;
  <a href="/Admin" style="font-size:.9rem;color:#64748b;text-decoration:none;">← Retour à l'admin</a>
</div>

<div class="report-header">
  <div class="logo-box">
    @if (showClientLogo)
    {
      <img src="@clientLogo" alt="Logo client"/>
    }
    else
    {
      <div class="logo-placeholder">[Logo client]</div>
    }
  </div>
  <div class="title-block">
    <h1>@siteName</h1>
    <div class="subtitle">Rapport journalier — Gestion de file d'attente</div>
    <div class="badge-date">@date</div>
  </div>
  <div class="logo-box">
    @if (showNoubaLogo)
    {
      <img src="~/images/nouba-logo.png" alt="Nouba Pro"/>
    }
  </div>
</div>

<p class="subtitle">Généré le @DateTime.Now.ToString("dd/MM/yyyy à HH:mm") · @total ticket@(total>1?"s":"") au total</p>

<div class="kpis">
  <div class="kpi blue"><div class="kpi-val">@total</div><div class="kpi-label">Total tickets</div></div>
  <div class="kpi green"><div class="kpi-val">@served</div><div class="kpi-label">Traités</div></div>
  <div class="kpi red"><div class="kpi-val">@absent</div><div class="kpi-label">Absents</div></div>
  <div class="kpi yellow"><div class="kpi-val">@waiting</div><div class="kpi-label">En attente</div></div>
  <div class="kpi"><div class="kpi-val">@(avgWait > 0 ? $"{avgWait} min" : "—")</div><div class="kpi-label">Délai moy.</div></div>
</div>

<h2>Statistiques par service</h2>
<table>
  <tr>
    <th>Service</th><th>Code</th><th>Total</th><th>Traités</th><th>Absents</th><th>En attente</th><th>Prioritaires</th>
  </tr>
  @foreach (var svc in services) {
    var st = tickets.Where(t => t.ServiceTypeId == svc.Id).ToList();
    <tr>
      <td><strong>@svc.Name</strong></td>
      <td>@svc.Code</td>
      <td><strong>@st.Count</strong></td>
      <td><span class="badge b-done">@st.Count(t=>t.Status==TicketStatus.Finished)</span></td>
      <td><span class="badge b-absent">@st.Count(t=>t.Status==TicketStatus.Absent)</span></td>
      <td><span class="badge b-wait">@st.Count(t=>t.Status==TicketStatus.Waiting)</span></td>
      <td>@st.Count(t=>t.IsPriority)</td>
    </tr>
  }
</table>

<h2>Détail des tickets (@total)</h2>
<table>
  <tr>
    <th>#</th><th>Numéro</th><th>Service</th><th>Statut</th><th>Créé à</th><th>Appelé à</th><th>Guichet</th><th>Agent</th><th>Prio.</th>
  </tr>
  @{ int idx = 1; }
  @foreach (var t in tickets) {
    var h = histories.FirstOrDefault(x => x.TicketId == t.Id);
    <tr>
      <td style="color:#94a3b8">@idx</td>
      <td><strong>@t.Number</strong></td>
      <td>@t.ServiceType?.Name</td>
      <td>
        @switch(t.Status) {
          case TicketStatus.Waiting:  <span class="badge b-wait">Attente</span>    break;
          case TicketStatus.Called:   <span class="badge b-called">Appelé</span>   break;
          case TicketStatus.Finished: <span class="badge b-done">Traité</span>     break;
          case TicketStatus.Absent:   <span class="badge b-absent">Absent</span>   break;
        }
      </td>
      <td>@t.CreatedAt.ToString("HH:mm")</td>
      <td>@(t.CalledAt.HasValue ? t.CalledAt.Value.ToString("HH:mm") : "—")</td>
      <td>@(h?.CounterName ?? "—")</td>
      <td>@(h?.AgentName ?? "—")</td>
      <td>@(t.IsPriority ? $"⚡ {t.PriorityReason}" : "")</td>
    </tr>
    idx++;
  }
</table>

<div class="footer">
  <strong>Nouba Pro</strong> — Rapport généré automatiquement · @siteName · @date<br/>
  <span style="font-size:7pt;color:#cbd5e1">© 2026 Nouba Software · support@nouba.dz · www.nouba.dz</span>
</div>
<script>
// Auto-print si ouvert depuis un lien "imprimer" (paramètre autoprint=1)
if(new URLSearchParams(window.location.search).get('autoprint')==='1'){
  setTimeout(function(){window.print();},400);
}
</script>
</body>
</html>
