@{
    Layout = null;
    var settings = ViewBag.Settings as Nouba.Models.UiSettings;
    var siteName = settings?.SiteName ?? "Nouba";
}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
<meta name="theme-color" content="#0f172a"/>
<title>Suivi — @siteName</title>
<link rel="icon" type="image/png" href="~/images/favicon.png"/>
<style>
*,*::before,*::after{box-sizing:border-box}
html,body{margin:0;padding:0;min-height:100dvh;background:radial-gradient(ellipse at top,#1e293b 0%,#020617 70%);color:#e2e8f0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
body{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:30px 16px}
.brand{display:flex;align-items:center;gap:10px;color:#94a3b8;font-size:.85rem;margin-bottom:24px;letter-spacing:.04em}
.brand strong{color:#fff;font-weight:700}
.card{background:#0f172a;border:1px solid #1e293b;border-radius:24px;padding:32px 24px;width:100%;max-width:420px;text-align:center;box-shadow:0 30px 60px rgba(0,0,0,.4)}
h1{margin:0 0 6px 0;font-size:1.5rem;color:#fff}
p.lead{margin:0 0 22px 0;color:#94a3b8;font-size:.9rem;line-height:1.5}
input{width:100%;padding:18px;font-size:1.6rem;text-align:center;letter-spacing:.4em;text-transform:uppercase;background:#020617;color:#fff;border:2px solid #1e293b;border-radius:14px;font-weight:700;font-family:inherit;outline:none;transition:border-color .2s}
input:focus{border-color:#e8b84b}
button{width:100%;margin-top:14px;padding:16px;font-size:1rem;font-weight:800;background:linear-gradient(135deg,#e8b84b,#4f46e5);color:#fff;border:none;border-radius:14px;cursor:pointer;letter-spacing:.04em}
button:hover{filter:brightness(1.1)}
.error{margin-top:14px;color:#fca5a5;font-size:.85rem}
</style>
</head>
<body>
  <div class="brand"><span>📋</span><strong>@siteName</strong></div>
  <main class="card">
    <h1>Suivre mon ticket</h1>
    <p class="lead">Saisissez le code à 8 caractères affiché sur votre ticket.</p>
    <input type="text" id="pid" placeholder="XXXXXXXX" maxlength="8" autocomplete="off" autocapitalize="characters" inputmode="latin"/>
    <button type="button" onclick="go()">Voir mon ticket</button>
    <div class="error" id="err"></div>
  </main>
<script>
function go(){
  var v = (document.getElementById('pid').value || '').trim().toUpperCase();
  if (v.length < 6 || v.length > 16) {
    document.getElementById('err').textContent = 'Code invalide (6 à 16 caractères).';
    return;
  }
  window.location.href = '/suivi/' + encodeURIComponent(v);
}
document.getElementById('pid').addEventListener('keydown', function(e){ if (e.key === 'Enter') go(); });
</script>
</body>
</html>
